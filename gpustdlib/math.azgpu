module gpustdlib.math

func clamp(value: Float, low: Float, high: Float): Float {
    if value < low { return low }
    if value > high { return high }
    return value
}

func saturate(value: Float): Float {
    return clamp(value, 0.0, 1.0)
}

func lerp(start: Float, end: Float, weight: Float): Float {
    return start + (end - start) * weight
}

func dot2(a: Float2, b: Float2): Float {
    return a.x * b.x + a.y * b.y
}

func dot3(a: Float3, b: Float3): Float {
    return a.x * b.x + a.y * b.y + a.z * b.z
}

func cross(a: Float3, b: Float3): Float3 {
    return Float3(
        a.y * b.z - a.z * b.y,
        a.z * b.x - a.x * b.z,
        a.x * b.y - a.y * b.x
    )
}
