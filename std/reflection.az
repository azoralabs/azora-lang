module std.reflection

/**
 * @file std/reflection
 *
 * The compile-time reflection intrinsic. `std::reflect<X>` yields a compile-time
 * handle to the declaration named `X` (a type, a value binding, or a `Type::member`
 * path). It is used as a prop - no call parentheses - and is only valid in
 * compile-time positions:
 *
 * ```
 * std::reflect<P>.hasDeco<Serializable>       // Bool
 * std::reflect<P>.decoMeta<SerialName>.value  // decorator field
 * std::reflect<P>.enclosingRealm?.label        // enclosing realm metadata
 * ```
 *
 * The compiler lowers every `std::reflect<X>` at parse time, so the declaration
 * below is a placeholder that is never executed.
 *
 * @since 0.1
 */

realm std {
    /**
     * Compile-time reflection handle for the declaration `T`, produced by
     * `std::reflect<T>`. Its members (`.hasDeco<D>`, `.decoMeta<D>`, `.enclosingRealm`) are
     * resolved by the compiler; `bridge pack` means no struct is emitted.
     */
    @Experimental(since: "0.1")
    bridge pack Reflected<T>

    impl<T> Reflected {
        /** Whether the reflected declaration `T` carries decorator `D`. */
        @Experimental(since: "0.1")
        bridge prop<D> hasDeco[self: Self&]: Bool

        /** Immutable compile-time metadata from decorator `D` on `T`. */
        @Experimental(since: "0.1")
        bridge prop<D> decoMeta[self: Self&]: D

        /** The enclosing lexical realm of `T`, or null at global scope. */
        @Experimental(since: "0.1")
        bridge prop enclosingRealm[self: Self&]: Realm?

        /**
         * Every program type carrying decorator `D`. Read from the whole-program
         * handle `std::reflect<*>` and iterated with
         * `inline for X in std::reflect<*>.withDeco<D> { … }`, which the compiler
         * unrolls at compile time into static references to each matching type -
         * no runtime cost and no function values, so it lowers to every backend.
         */
        @Experimental(since: "0.1")
        bridge prop<D> withDeco[self: Self&]: Array<Type>

        /**
         * The declared fields of `T`, in declaration order.
         *
         * Iterated at compile time with `inline for f in std::reflect<T>.fields { … }`,
         * which unrolls into one copy of the body per field. Each `f` exposes
         * [ReflectedField.name] and [ReflectedField.value]; a spliced member name
         * (`self.${f.name}`) folds to the field itself during expansion, so nothing
         * survives to runtime.
         *
         * For a generic type this reports the fields of the *specialization* being
         * reflected, so a conditional field is present only where its condition holds.
         */
        @Experimental(since: "0.1")
        bridge prop fields[self: Self&]: Array<ReflectedField>
    }

    /**
     * One field of a reflected declaration.
     *
     * Exists only at compile time: every member is folded during expansion, so a
     * `ReflectedField` never reaches the generated program.
     */
    @Experimental(since: "0.1")
    bridge pack ReflectedField

    impl ReflectedField {
        /** The field's declared name, usable as a spliced member name. */
        @Experimental(since: "0.1")
        bridge prop name[self: Self&]: String

        /** The field's value on the reflected receiver - `self.<name>`. */
        @Experimental(since: "0.1")
        bridge prop value[self: Self&]: Any
    }

    /**
     * Compile-time reflection handle for the declaration `T`. Used as a prop
     * (`std::reflect<T>`). `includeInherited` also surfaces decorators inherited
     * from base declarations when set.
     */
    @Experimental(since: "0.1")
    bridge func reflect<T>(includeInherited: Bool = false): Reflected<T>

    /** Compile-time handle for a lexical realm, from `std::reflect<T>.enclosingRealm`. */
    @Experimental(since: "0.1")
    bridge pack Realm

    impl Realm {
        /** The realm's label, or null for the global scope / an unlabeled realm. */
        @Experimental(since: "0.1")
        bridge prop label[self: Self&]: String?

        /** Whether this is an inline (compile-time) realm. */
        @Experimental(since: "0.1")
        bridge prop isInline[self: Self&]: Bool

        /** The enclosing parent realm, or null at the global scope. */
        @Experimental(since: "0.1")
        bridge prop parent[self: Self&]: Realm?
    }
}
