expose module std.traits.core

use realm std {
    inline for Ty in Numbers {
        /** Ascending range over [Ty], stepping by one. */
        oper.. [self: Ty&](rhs: Ty&) by 1
        /** Descending range over [Ty], stepping by one. */
        oper reverse.. [self: Ty&](rhs: Ty&) by 1
    }
}
