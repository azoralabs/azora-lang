/**
 * @file std/time.az
 *
 * Wall-clock, monotonic-clock, duration, and civil-calendar primitives.
 *
 * `Instant` identifies a point on the Unix time line. `MonotonicInstant` is
 * suitable only for measuring elapsed time and intentionally cannot be
 * converted to a calendar date. `DateTime` combines a validated local date,
 * local time, and fixed UTC offset. Named time-zone databases are deliberately
 * outside this module: an offset is unambiguous and has no mutable external
 * rules, while IANA zone support can be layered on top later.
 *
 * Seconds and nanoseconds use a normalized split representation. This avoids
 * the year-2262 overflow of a single signed 64-bit nanosecond counter and keeps
 * sub-second arithmetic exact.
 */
@Supress(.Unused)
module std.time

import std::{
    char::*
    container.list::*
    serializer::*
    string::*
}

/** Errors raised by validation, parsing, and unsafe temporal arithmetic. */
@Experimental(since: "0.1")
error TimeError {
    InvalidDuration
    InvalidDate
    InvalidTime
    InvalidOffset
    InvalidFormat
    ArithmeticOverflow
    UnsupportedRange
}

/** Days of the ISO week, ordered from Monday through Sunday. */
@Experimental(since: "0.1")
enum Weekday {
    Monday
    Tuesday
    Wednesday
    Thursday
    Friday
    Saturday
    Sunday
}

/**
 * Exact signed duration with nanosecond precision.
 *
 * The canonical representation keeps `nanosecondAdjustment` in
 * `0..999,999,999`; negative fractions are carried in `seconds`.
 */
@Experimental(since: "0.1")
@Serializable
pack Duration {
    fin seconds: Long = 0
    fin nanosecondAdjustment: Int = 0
}

/** A point on the Unix time line, independent of any calendar or offset. */
@Experimental(since: "0.1")
@Serializable
pack Instant {
    fin epochSecond: Long
    fin nanosecond: Int = 0
}

/** Opaque reading from a monotonic clock, used only for elapsed time. */
@Experimental(since: "0.1")
pack MonotonicInstant {
    fin readingNanoseconds: Long
}

/** A validated proleptic-Gregorian calendar date. */
@Experimental(since: "0.1")
@Serializable
pack LocalDate {
    fin year: Int
    fin month: Int
    fin day: Int
}

/** A validated time of day with nanosecond precision. */
@Experimental(since: "0.1")
@Serializable
pack LocalTime {
    fin hour: Int
    fin minute: Int
    fin second: Int
    fin nanosecond: Int = 0
}

/** Fixed displacement from UTC, constrained to the ISO range of +/-18:00. */
@Experimental(since: "0.1")
@Serializable
pack UtcOffset {
    fin totalSeconds: Int = 0
}

/** A local civil date and time paired with a fixed UTC offset. */
@Experimental(since: "0.1")
@Serializable
pack DateTime {
    fin date: LocalDate
    fin time: LocalTime
    fin offset: UtcOffset
}

/** Source of wall-clock and monotonic time. Injectable clocks make tests deterministic. */
@Experimental(since: "0.1")
spec Clock {
    /** Returns the current Unix instant. */
    func &.now(): Instant

    /** Returns an opaque monotonic reading. */
    func &.monotonicNow(): MonotonicInstant
}

/** Host-backed implementation of `Clock`. */
@Experimental(since: "0.1")
pack SystemClock

@Experimental(since: "0.1")
impl Clock for SystemClock {
    func &.now(): Instant {
        return instantFromEpochNanoseconds(azoraTimeUnixNanoseconds())
    }

    func &.monotonicNow(): MonotonicInstant {
        return MonotonicInstant(azoraTimeMonotonicNanoseconds())
    }
}

/** Creates a normalized duration from seconds plus an arbitrary nanosecond adjustment. */
@Experimental(since: "0.1")
func duration(seconds: Long, nanosecondAdjustment: Long = 0): Duration {
    var normalizedSeconds = seconds + nanosecondAdjustment / 1000000000
    var normalizedNanos = nanosecondAdjustment % 1000000000
    if normalizedNanos < 0 {
        normalizedSeconds -= 1
        normalizedNanos += 1000000000
    }
    return Duration(normalizedSeconds, normalizedNanos as Int)
}

/** Creates a duration measured in whole nanoseconds. */
@Experimental(since: "0.1")
func nanoseconds(value: Long): Duration { return duration(0, value) }

/** Creates a duration measured in whole microseconds. */
@Experimental(since: "0.1")
func microseconds(value: Long): Duration { return duration(0, value * 1000) }

/** Creates a duration measured in whole milliseconds. */
@Experimental(since: "0.1")
func milliseconds(value: Long): Duration { return duration(0, value * 1000000) }

/** Creates a duration measured in whole seconds. */
@Experimental(since: "0.1")
func seconds(value: Long): Duration { return duration(value) }

/** Creates a duration measured in whole minutes. */
@Experimental(since: "0.1")
func minutes(value: Long): Duration { return duration(value * 60) }

/** Creates a duration measured in fixed 60-minute hours. */
@Experimental(since: "0.1")
func hours(value: Long): Duration { return duration(value * 3600) }

/** Creates a duration measured in fixed 24-hour days. */
@Experimental(since: "0.1")
func days(value: Long): Duration { return duration(value * 86400) }

// Unit suffixes: `250.milliseconds` reads as the value it denotes, so a call
// site states its unit instead of leaving a bare number to be interpreted.
// Each one delegates to the factory of the same name above.

/** This many whole nanoseconds, as a [Duration]. */
@Experimental(since: "0.1")
prop (self: Int&).nanoseconds: Duration = nanoseconds(self as Long)

/** This many whole microseconds, as a [Duration]. */
@Experimental(since: "0.1")
prop (self: Int&).microseconds: Duration = microseconds(self as Long)

/** This many whole milliseconds, as a [Duration]. */
@Experimental(since: "0.1")
prop (self: Int&).milliseconds: Duration = milliseconds(self as Long)

/** This many whole seconds, as a [Duration]. */
@Experimental(since: "0.1")
prop (self: Int&).seconds: Duration = seconds(self as Long)

/** This many whole minutes, as a [Duration]. */
@Experimental(since: "0.1")
prop (self: Int&).minutes: Duration = minutes(self as Long)

/** This many fixed 60-minute hours, as a [Duration]. */
@Experimental(since: "0.1")
prop (self: Int&).hours: Duration = hours(self as Long)

/** This many fixed 24-hour days, as a [Duration]. */
@Experimental(since: "0.1")
prop (self: Int&).days: Duration = days(self as Long)

/** This many whole nanoseconds, as a [Duration]. */
@Experimental(since: "0.1")
prop (self: Long&).nanoseconds: Duration = nanoseconds(self)

/** This many whole microseconds, as a [Duration]. */
@Experimental(since: "0.1")
prop (self: Long&).microseconds: Duration = microseconds(self)

/** This many whole milliseconds, as a [Duration]. */
@Experimental(since: "0.1")
prop (self: Long&).milliseconds: Duration = milliseconds(self)

/** This many whole seconds, as a [Duration]. */
@Experimental(since: "0.1")
prop (self: Long&).seconds: Duration = seconds(self)

/** This many whole minutes, as a [Duration]. */
@Experimental(since: "0.1")
prop (self: Long&).minutes: Duration = minutes(self)

/** This many fixed 60-minute hours, as a [Duration]. */
@Experimental(since: "0.1")
prop (self: Long&).hours: Duration = hours(self)

/** This many fixed 24-hour days, as a [Duration]. */
@Experimental(since: "0.1")
prop (self: Long&).days: Duration = days(self)

impl Duration {
    /** Whether this duration is exactly zero. */
    prop &.isZero: Bool = self.seconds == 0 && self.nanosecondAdjustment == 0

    /** Whether this duration is strictly negative. */
    prop &.isNegative: Bool = self.seconds < 0

    /** Whole milliseconds truncated toward negative infinity. */
    prop &.inWholeMilliseconds: Long = self.seconds * 1000 + (self.nanosecondAdjustment / 1000000) as Long

    /** Returns the magnitude with its sign reversed. */
    func &.negated(): Duration {
        return duration(0 - self.seconds, 0 - self.nanosecondAdjustment as Long)
    }

    /** Adds another exact duration. */
    func &.plus(other: Duration&): Duration {
        return duration(
            self.seconds + other.seconds,
            self.nanosecondAdjustment as Long + other.nanosecondAdjustment as Long
        )
    }

    /** Subtracts another exact duration. */
    func &.minus(other: Duration&): Duration {
        return self.plus(other.negated())
    }
}

/** Creates a normalized Unix instant. */
@Experimental(since: "0.1")
func instant(epochSecond: Long, nanosecondAdjustment: Long = 0): Instant {
    fin normalized = duration(epochSecond, nanosecondAdjustment)
    return Instant(normalized.seconds, normalized.nanosecondAdjustment)
}

/** Converts a signed Unix nanosecond count to a normalized instant. */
@Experimental(since: "0.1")
func instantFromEpochNanoseconds(value: Long): Instant {
    return instant(0, value)
}

/** Returns the current wall-clock instant from the system clock. */
@Experimental(since: "0.1")
func now(): Instant { return SystemClock().now() }

/** Returns the current monotonic reading from the system clock. */
@Experimental(since: "0.1")
func monotonicNow(): MonotonicInstant { return SystemClock().monotonicNow() }

impl Instant {
    /** Whole Unix milliseconds, truncated toward negative infinity. */
    prop &.epochMilliseconds: Long = self.epochSecond * 1000 + (self.nanosecond / 1000000) as Long

    /** Adds an exact duration while retaining the normalized representation. */
    func &.plus(value: Duration&): Instant {
        return instant(
            self.epochSecond + value.seconds,
            self.nanosecond as Long + value.nanosecondAdjustment as Long
        )
    }

    /** Subtracts an exact duration. */
    func &.minus(value: Duration&): Instant {
        return self.plus(value.negated())
    }

    /** Returns the exact elapsed duration from `earlier` to this instant. */
    func &.durationSince(earlier: Instant&): Duration {
        return duration(
            self.epochSecond - earlier.epochSecond,
            self.nanosecond as Long - earlier.nanosecond as Long
        )
    }

    /** Converts this instant to civil time at a fixed UTC offset. */
    func &.atOffset(offset: UtcOffset): DateTime {
        return atOffset(self, offset)
    }

    /** Formats this instant as canonical UTC ISO-8601 text. */
    func &.formatIso(): String {
        return formatIsoInstant(self)
    }
}

impl MonotonicInstant {
    /** Returns elapsed time; fails if the readings are not ordered. */
    func &.elapsedSince(earlier: MonotonicInstant&): Duration ?! TimeError {
        if self.readingNanoseconds < earlier.readingNanoseconds { return .InvalidDuration }
        return nanoseconds(self.readingNanoseconds - earlier.readingNanoseconds)
    }
}

/** Returns whether `year` is a leap year in the proleptic Gregorian calendar. */
@Experimental(since: "0.1")
func isLeapYear(year: Int): Bool {
    return year % 4 == 0 && (year % 100 != 0 || year % 400 == 0)
}

/** Returns the number of days in a validated month. */
@Experimental(since: "0.1")
func daysInMonth(year: Int, month: Int): Int ?! TimeError {
    if month < 1 || month > 12 { return .InvalidDate }
    if month == 2 {
        if isLeapYear(year) { return 29 }
        return 28
    }
    if month == 4 || month == 6 || month == 9 || month == 11 { return 30 }
    return 31
}

/** Creates and validates a Gregorian date. */
@Experimental(since: "0.1")
func localDate(year: Int, month: Int, day: Int): LocalDate ?! TimeError {
    if day < 1 || day > try daysInMonth(year, month) { return .InvalidDate }
    return LocalDate(year, month, day)
}

/** Creates and validates a local time of day. Leap seconds are not accepted. */
@Experimental(since: "0.1")
func localTime(hour: Int, minute: Int, second: Int, nanosecond: Int = 0): LocalTime ?! TimeError {
    if hour < 0 || hour > 23 { return .InvalidTime }
    if minute < 0 || minute > 59 { return .InvalidTime }
    if second < 0 || second > 59 { return .InvalidTime }
    if nanosecond < 0 || nanosecond > 999999999 { return .InvalidTime }
    return LocalTime(hour, minute, second, nanosecond)
}

/** Creates a validated fixed UTC offset. */
@Experimental(since: "0.1")
func utcOffset(totalSeconds: Int): UtcOffset ?! TimeError {
    if totalSeconds < -64800 || totalSeconds > 64800 {
        return .InvalidOffset
    }
    return UtcOffset(totalSeconds)
}

/** Creates a validated fixed UTC offset from signed hours and minutes. */
@Experimental(since: "0.1")
func utcOffsetOf(hours: Int, minutes: Int = 0): UtcOffset ?! TimeError {
    if minutes < 0 || minutes > 59 {
        return .InvalidOffset
    }
    if hours < -18 || hours > 18 {
        return .InvalidOffset
    }
    var sign = 1
    if hours < 0 {
        sign = -1
    }
    var absoluteHours = hours
    if hours < 0 {
        absoluteHours = 0 - hours
    }
    if absoluteHours == 18 && minutes != 0 {
        return .InvalidOffset
    }
    return utcOffset(sign * (absoluteHours * 3600 + minutes * 60))
}

/** Creates a validated offset date-time. */
@Experimental(since: "0.1")
func dateTime(date: LocalDate, time: LocalTime, offset: UtcOffset): DateTime {
    return DateTime(date, time, offset)
}

impl LocalDate {
    /** ISO weekday corresponding to this date. */
    prop &.weekday: Weekday = weekday(self)
}

impl DateTime {
    /** Converts this fixed-offset civil value to its unique Unix instant. */
    func &.toInstant(): Instant {
        return toInstant(self)
    }

    /** Formats this value as canonical ISO-8601 offset date-time text. */
    func &.formatIso(): String {
        return formatIsoDateTime(self)
    }
}

/** Converts a date-time to its unique Unix instant. */
@Experimental(since: "0.1")
func toInstant(value: DateTime&): Instant {
    fin epochDay = _daysFromCivil(value.date.year, value.date.month, value.date.day)
    fin localSecond = epochDay * 86400 +
        (value.time.hour as Long) * 3600 +
        (value.time.minute as Long) * 60 +
        (value.time.second as Long)
    return instant(localSecond - (value.offset.totalSeconds as Long), value.time.nanosecond as Long)
}

/** Converts an instant to a date-time at the requested fixed offset. */
@Experimental(since: "0.1")
func atOffset(value: Instant&, offset: UtcOffset): DateTime {
    fin localSecond = value.epochSecond + offset.totalSeconds as Long
    fin epochDay = _floorDiv(localSecond, 86400)
    fin secondOfDay = localSecond - epochDay * 86400
    fin date = _civilFromDays(epochDay)
    fin hour = (secondOfDay / 3600) as Int
    fin minute = ((secondOfDay % 3600) / 60) as Int
    fin second = (secondOfDay % 60) as Int
    return DateTime(date, LocalTime(hour, minute, second, value.nanosecond), offset)
}

/** Returns the ISO weekday for a date. */
@Experimental(since: "0.1")
func weekday(value: LocalDate&): Weekday {
    fin epochDay = _daysFromCivil(value.year, value.month, value.day)
    fin index = _floorMod(epochDay + 3, 7) as Int
    if index == 0 { return Weekday.Monday }
    if index == 1 { return Weekday.Tuesday }
    if index == 2 { return Weekday.Wednesday }
    if index == 3 { return Weekday.Thursday }
    if index == 4 { return Weekday.Friday }
    if index == 5 { return Weekday.Saturday }
    return Weekday.Sunday
}

/** Formats a date-time using the canonical ISO-8601 extended representation. */
@Experimental(since: "0.1")
func formatIsoDateTime(value: DateTime&): String {
    var result = _pad4(value.date.year) + "-" + _pad2(value.date.month) + "-" + _pad2(value.date.day) +
        "T" + _pad2(value.time.hour) + ":" + _pad2(value.time.minute) + ":" + _pad2(value.time.second)
    if value.time.nanosecond != 0 {
        result += _formatFraction(value.time.nanosecond)
    }
    if value.offset.totalSeconds == 0 {
        return result + "Z"
    }
    var offset = value.offset.totalSeconds
    var sign = "+"
    if offset < 0 {
        sign = "-"
        offset = 0 - offset
    }
    fin offsetSecond = offset % 60
    var suffix = sign + _pad2(offset / 3600) + ":" + _pad2((offset % 3600) / 60)
    if offsetSecond != 0 {
        suffix += ":" + _pad2(offsetSecond)
    }
    return result + suffix
}

/** Formats an instant in canonical UTC ISO-8601 form. */
@Experimental(since: "0.1")
func formatIsoInstant(value: Instant&): String {
    return formatIsoDateTime(atOffset(value, UtcOffset(0)))
}

/**
 * Parses canonical ISO-8601 offset date-time text.
 *
 * Accepted years are `0000..9999`; offsets must be `Z`, `+/-HH:MM`, or
 * `+/-HH:MM:SS` when second precision is required.
 * Fractional seconds may contain one through nine digits.
 */
@Experimental(since: "0.1")
func parseIsoDateTime(value: String): DateTime ?! TimeError {
    fin length = stringLength(value)
    if length < 20 { return .InvalidFormat }
    if charAt(value, 4) != '-' || charAt(value, 7) != '-' ||
        (charAt(value, 10) != 'T' && charAt(value, 10) != 't') ||
        charAt(value, 13) != ':' || charAt(value, 16) != ':' {
        return .InvalidFormat
    }
    if !_digitsAt(value, 0, 4) || !_digitsAt(value, 5, 2) || !_digitsAt(value, 8, 2) ||
        !_digitsAt(value, 11, 2) || !_digitsAt(value, 14, 2) || !_digitsAt(value, 17, 2) {
        return .InvalidFormat
    }

    fin year = _decimalAt(value, 0, 4)
    fin month = _decimalAt(value, 5, 2)
    fin day = _decimalAt(value, 8, 2)
    fin hour = _decimalAt(value, 11, 2)
    fin minute = _decimalAt(value, 14, 2)
    fin second = _decimalAt(value, 17, 2)
    var nanosecond = 0
    var index = 19

    if index < length && charAt(value, index) == '.' {
        index += 1
        fin fractionStart = index
        while index < length && charIsDigit(charAt(value, index)) { index += 1 }
        fin digits = index - fractionStart
        if digits < 1 || digits > 9 { return .InvalidFormat }
        nanosecond = _decimalAt(value, fractionStart, digits)
        for scale in digits..<9 {
            nanosecond *= 10
        }
    }

    var offsetSeconds = 0
    if index < length && (charAt(value, index) == 'Z' || charAt(value, index) == 'z') {
        index += 1
    } else {
        fin remaining = length - index
        if remaining != 6 && remaining != 9 { return .InvalidFormat }
        fin signChar = charAt(value, index)
        if signChar != '+' && signChar != '-' { return .InvalidFormat }
        if charAt(value, index + 3) != ':' || !_digitsAt(value, index + 1, 2) || !_digitsAt(value, index + 4, 2) {
            return .InvalidFormat
        }
        fin offsetHour = _decimalAt(value, index + 1, 2)
        fin offsetMinute = _decimalAt(value, index + 4, 2)
        if offsetHour > 18 || offsetMinute > 59 { return .InvalidOffset }
        offsetSeconds = offsetHour * 3600 + offsetMinute * 60
        if remaining == 9 {
            if charAt(value, index + 6) != ':' || !_digitsAt(value, index + 7, 2) { return .InvalidFormat }
            fin offsetSecond = _decimalAt(value, index + 7, 2)
            if offsetSecond > 59 { return .InvalidOffset }
            offsetSeconds += offsetSecond
        }
        if offsetHour == 18 && offsetSeconds != 64800 { return .InvalidOffset }
        if signChar == '-' { offsetSeconds = 0 - offsetSeconds }
        index += remaining
    }
    if index != length { return .InvalidFormat }

    fin date = try localDate(year, month, day)
    fin time = try localTime(hour, minute, second, nanosecond)
    fin offset = try utcOffset(offsetSeconds)
    return DateTime(date, time, offset)
}

/** Parses canonical UTC instant text. */
@Experimental(since: "0.1")
func parseIsoInstant(value: String): Instant ?! TimeError {
    return toInstant(try parseIsoDateTime(value))
}

/** Serializer that represents `Instant` as canonical UTC ISO-8601 text. */
@Experimental(since: "0.1")
pack InstantSerializer

@Experimental(since: "0.1")
impl Serializer<Instant> for InstantSerializer {
    func &.toSerialValue(value: Instant&): SerialValue ?! SerializationError {
        return SerialValue.Text(formatIsoInstant(value))
    }

    func &.fromSerialValue(value: SerialValue&): Instant ?! SerializationError {
        when value {
            SerialValue.Text(text) -> {
                try {
                    return try parseIsoInstant(text)
                } catch {
                    return .UnexpectedType
                }
            }
            else -> { return .UnexpectedType }
        }
    }
}

/** Serializer that represents `DateTime` as canonical offset ISO-8601 text. */
@Experimental(since: "0.1")
pack DateTimeSerializer

@Experimental(since: "0.1")
impl Serializer<DateTime> for DateTimeSerializer {
    func &.toSerialValue(value: DateTime&): SerialValue ?! SerializationError {
        return SerialValue.Text(formatIsoDateTime(value))
    }

    func &.fromSerialValue(value: SerialValue&): DateTime ?! SerializationError {
        when value {
            SerialValue.Text(text) -> {
                try {
                    return try parseIsoDateTime(text)
                } catch {
                    return .UnexpectedType
                }
            }
            else -> { return .UnexpectedType }
        }
    }
}

/** Serializer that preserves the normalized split representation of `Duration`. */
@Experimental(since: "0.1")
pack DurationSerializer

@Experimental(since: "0.1")
impl Serializer<Duration> for DurationSerializer {
    func &.toSerialValue(value: Duration&): SerialValue ?! SerializationError {
        var fields = List<SerialField>()
        fields.add(SerialField("seconds", SerialValue.Number(value.seconds as String)))
        fields.add(SerialField("nanosecondAdjustment", SerialValue.Number(value.nanosecondAdjustment as String)))
        return SerialValue.Object(fields)
    }

    func &.fromSerialValue(value: SerialValue&): Duration ?! SerializationError {
        fin secondsValue = try serialField(value, "seconds")
        fin nanosValue = try serialField(value, "nanosecondAdjustment")
        when secondsValue {
            SerialValue.Number(secondsText) -> {
                when nanosValue {
                    SerialValue.Number(nanosText) -> {
                        return duration(try _parseLong(secondsText), try _parseLong(nanosText) as Long)
                    }
                    else -> { return .UnexpectedType }
                }
            }
            else -> { return .UnexpectedType }
        }
    }
}

func _floorDiv(value: Long, divisor: Long): Long {
    var quotient = value / divisor
    fin remainder = value % divisor
    if remainder != 0 && ((remainder < 0) != (divisor < 0)) { quotient -= 1 }
    return quotient
}

func _floorMod(value: Long, divisor: Long): Long {
    return value - _floorDiv(value, divisor) * divisor
}

func _daysFromCivil(year: Int, month: Int, day: Int): Long {
    var y = year as Long
    fin m = month as Long
    if m <= 2 { y -= 1 }
    fin era = _floorDiv(y, 400)
    fin yearOfEra = y - era * 400
    var adjustedMonth = m - 3
    if m <= 2 { adjustedMonth = m + 9 }
    fin dayOfYear = (153 * adjustedMonth + 2) / 5 + day as Long - 1
    fin dayOfEra = yearOfEra * 365 + yearOfEra / 4 - yearOfEra / 100 + dayOfYear
    return era * 146097 + dayOfEra - 719468
}

func _civilFromDays(epochDay: Long): LocalDate {
    fin z = epochDay + 719468
    fin era = _floorDiv(z, 146097)
    fin dayOfEra = z - era * 146097
    fin yearOfEra = (dayOfEra - dayOfEra / 1460 + dayOfEra / 36524 - dayOfEra / 146096) / 365
    var year = yearOfEra + era * 400
    fin dayOfYear = dayOfEra - (365 * yearOfEra + yearOfEra / 4 - yearOfEra / 100)
    fin monthPrime = (5 * dayOfYear + 2) / 153
    fin day = dayOfYear - (153 * monthPrime + 2) / 5 + 1
    var month = monthPrime + 3
    if monthPrime >= 10 { month = monthPrime - 9 }
    if month <= 2 { year += 1 }
    return LocalDate(year as Int, month as Int, day as Int)
}

func _pad2(value: Int): String {
    if value < 10 { return "0$value" }
    return value as String
}

func _pad4(value: Int): String {
    fin text = value as String
    if value < 0 || value > 9999 {
        return text
    }
    if value < 10 { return "000" + text }
    if value < 100 { return "00" + text }
    if value < 1000 { return "0" + text }
    return text
}

func _formatFraction(value: Int): String {
    var text = value as String
    while stringLength(text) < 9 { text = "0" + text }
    var end = stringLength(text)
    while end > 1 && charAt(text, end - 1) == '0' { end -= 1 }
    return "." + substring(text, 0, end)
}

func _digitsAt(value: String, start: Int, count: Int): Bool {
    if start < 0 || count < 0 || start + count > stringLength(value) {
        return false
    }
    for i in start..<start + count {
        if !charIsDigit(charAt(value, i)) {
            return false
        }
    }
    return true
}

func _decimalAt(value: String, start: Int, count: Int): Int {
    var result = 0
    for i in start..<start + count {
        result = result * 10 + charToCode(charAt(value, i)) - 48
    }
    return result
}

func _parseLong(value: String): Long ?! SerializationError {
    if stringLength(value) == 0 {
        return .InvalidNumber
    }
    var sign: Long = 1
    var index = 0
    if charAt(value, 0) == '-' {
        sign = -1
        index = 1
    }
    if index >= stringLength(value) {
        return .InvalidNumber
    }
    var result: Long = 0
    while index < stringLength(value) {
        fin c = charAt(value, index)
        if !charIsDigit(c) {
            return .InvalidNumber
        }
        result = result * 10 + (charToCode(c) - 48) as Long
        index += 1
    }
    return result * sign
}

bridge [.C, .WebAssembly] {
    /** Host runtime hook returning Unix time as signed nanoseconds. */
    func azoraTimeUnixNanoseconds(): Long

    /** Host runtime hook returning a process-monotonic signed nanosecond reading. */
    func azoraTimeMonotonicNanoseconds(): Long
}

// ---------------------------------------------------------------------------
// Unit tests
// ---------------------------------------------------------------------------

test "duration normalizes positive nanosecond overflow" {
    fin value = duration(2, 1500000000)
    assert value.seconds == 3 { "overflow nanoseconds must carry into seconds" }
    assert value.nanosecondAdjustment == 500000000 { "the remainder must stay normalized" }
}

test "duration normalizes negative nanoseconds" {
    fin value = duration(0, -1)
    assert value.seconds == -1 { "a negative fraction must borrow one second" }
    assert value.nanosecondAdjustment == 999999999 { "nanoseconds must remain non-negative" }
}

test "duration factories use fixed SI units" {
    assert microseconds(2).nanosecondAdjustment == 2000 { "microseconds must scale by 1,000" }
    assert milliseconds(2).nanosecondAdjustment == 2000000 { "milliseconds must scale by 1,000,000" }
    assert minutes(2).seconds == 120 { "minutes must contain 60 seconds" }
    assert hours(2).seconds == 7200 { "hours must contain 3,600 seconds" }
    assert days(2).seconds == 172800 { "fixed days must contain 86,400 seconds" }
}

test "unit suffixes match the factory of the same name" {
    assert 2.microseconds.nanosecondAdjustment == 2000 { "Int.microseconds must scale by 1,000" }
    assert 250.milliseconds.inWholeMilliseconds == 250 { "Int.milliseconds must scale by 1,000,000" }
    assert 2.minutes.seconds == 120 { "Int.minutes must contain 60 seconds" }
    assert 3.hours.seconds == 10800 { "Int.hours must contain 3,600 seconds" }
    assert 2.days.seconds == 172800 { "Int.days must contain 86,400 seconds" }
}

test "unit suffixes accept a Long receiver" {
    assert 3.hours.seconds == 10800 { "Long.hours must contain 3,600 seconds" }
    assert 1.nanoseconds.nanosecondAdjustment == 1 { "Long.nanoseconds must be exact" }
    assert 90.seconds.seconds == 90 { "Long.seconds must pass through unscaled" }
}

test "unit suffixes compose with duration arithmetic" {
    fin total = 1.seconds.plus(500.milliseconds)
    assert total.inWholeMilliseconds == 1500 { "unit suffixes must produce ordinary durations" }
}

test "duration arithmetic preserves normalization" {
    fin left = duration(1, 800000000)
    fin right = duration(2, 400000000)
    fin sum = left.plus(right)
    fin difference = sum.minus(right)
    assert sum.seconds == 4 && sum.nanosecondAdjustment == 200000000 { "addition must carry fractions" }
    assert difference.seconds == left.seconds { "subtraction must recover seconds" }
    assert difference.nanosecondAdjustment == left.nanosecondAdjustment { "subtraction must recover nanoseconds" }
}

test "duration negation handles negative fractions" {
    fin value = duration(0, -1).negated()
    assert value.seconds == 0 { "negating -1ns must not retain a negative second" }
    assert value.nanosecondAdjustment == 1 { "negating -1ns must produce +1ns" }
}

test "instant normalizes before epoch" {
    fin value = instant(0, -1)
    assert value.epochSecond == -1 { "negative fractions must cross the epoch correctly" }
    assert value.nanosecond == 999999999 { "instant nanoseconds must remain normalized" }
}

test "instant arithmetic and elapsed duration round trip" {
    fin start = instant(1700000000, 900000000)
    fin delta = milliseconds(250)
    fin finish = start.plus(delta)
    fin elapsed = finish.durationSince(start)
    assert finish.epochSecond == 1700000001 { "instant addition must carry into seconds" }
    assert finish.nanosecond == 150000000 { "instant addition must preserve the fraction" }
    assert elapsed.inWholeMilliseconds == 250 { "durationSince must recover the exact delta" }
}

test "leap year follows Gregorian rules" {
    assert isLeapYear(2000) { "years divisible by 400 are leap years" }
    assert !isLeapYear(1900) { "century years not divisible by 400 are common" }
    assert isLeapYear(2024) { "years divisible by four are leap years" }
    assert !isLeapYear(2023) { "ordinary years are not leap years" }
}

test "month lengths include leap February" {
    assert (daysInMonth(2024, 2) catch 0) == 29 { "leap February must have 29 days" }
    assert (daysInMonth(2023, 2) catch 0) == 28 { "common February must have 28 days" }
    assert (daysInMonth(2024, 4) catch 0) == 30 { "April must have 30 days" }
    assert (daysInMonth(2024, 12) catch 0) == 31 { "December must have 31 days" }
}

test "invalid month is rejected" {
    fin days = daysInMonth(2024, 13) catch -1
    assert days == -1 { "month 13 must fail validation" }
}

test "local date validates leap day" {
    fin valid = localDate(2024, 2, 29) catch LocalDate(0, 1, 1)
    fin invalid = localDate(2023, 2, 29) catch LocalDate(-1, 1, 1)
    assert valid.year == 2024 && valid.day == 29 { "2024-02-29 must be valid" }
    assert invalid.year == -1 { "2023-02-29 must fail validation" }
}

test "local time validates every boundary" {
    fin valid = localTime(23, 59, 59, 999999999) catch LocalTime(0, 0, 0)
    fin invalidHour = localTime(24, 0, 0) catch LocalTime(-1, 0, 0)
    fin invalidNanos = localTime(0, 0, 0, 1000000000) catch LocalTime(-1, 0, 0)
    assert valid.hour == 23 && valid.nanosecond == 999999999 { "the inclusive upper boundary must be valid" }
    assert invalidHour.hour == -1 { "hour 24 must fail" }
    assert invalidNanos.hour == -1 { "one billion nanoseconds must fail" }
}

test "UTC offset validates ISO limits" {
    assert (utcOffset(64800) catch UtcOffset(0)).totalSeconds == 64800 { "+18:00 must be valid" }
    assert (utcOffset(-64800) catch UtcOffset(0)).totalSeconds == -64800 { "-18:00 must be valid" }
    assert (utcOffset(64801) catch UtcOffset(-1)).totalSeconds == -1 { "offsets beyond +18:00 must fail" }
}

test "UTC offset hours and minutes preserve sign" {
    fin value = utcOffsetOf(-5, 30) catch UtcOffset(0)
    assert value.totalSeconds == -19800 { "-05:30 must remain negative" }
}

test "Unix epoch converts to civil UTC" {
    fin value = atOffset(instant(0), UtcOffset(0))
    assert value.date.year == 1970 && value.date.month == 1 && value.date.day == 1 { "epoch date changed" }
    assert value.time.hour == 0 && value.time.minute == 0 && value.time.second == 0 { "epoch time changed" }
}

test "pre-epoch instant uses floor division" {
    fin value = atOffset(instant(-1), UtcOffset(0))
    assert value.date.year == 1969 && value.date.month == 12 && value.date.day == 31 { "-1 second must be on the previous day" }
    assert value.time.hour == 23 && value.time.minute == 59 && value.time.second == 59 { "-1 second must map to 23:59:59" }
}

test "date time and instant round trip at an offset" {
    fin original = DateTime(LocalDate(2026, 7, 16), LocalTime(14, 25, 30, 123000000), UtcOffset(10800))
    fin restored = atOffset(toInstant(original), original.offset)
    assert restored.date.year == original.date.year && restored.date.month == original.date.month && restored.date.day == original.date.day { "date must round trip" }
    assert restored.time.hour == original.time.hour && restored.time.nanosecond == original.time.nanosecond { "time must round trip" }
}

test "weekday matches known calendar dates" {
    assert weekday(LocalDate(1970, 1, 1)) == Weekday.Thursday { "Unix epoch was Thursday" }
    assert LocalDate(2024, 2, 29).weekday == Weekday.Thursday { "2024 leap day was Thursday" }
}

test "ISO UTC formatting is canonical" {
    fin value = DateTime(LocalDate(2026, 7, 16), LocalTime(9, 5, 7), UtcOffset(0))
    assert formatIsoDateTime(value) == "2026-07-16T09:05:07Z" { "UTC formatting changed" }
}

test "ISO formatting trims fractional trailing zeroes" {
    fin value = DateTime(LocalDate(2026, 1, 2), LocalTime(3, 4, 5, 120000000), UtcOffset(0))
    assert value.formatIso() == "2026-01-02T03:04:05.12Z" { "fraction formatting must be canonical" }
}

test "ISO formatting includes offset seconds when needed" {
    fin value = DateTime(LocalDate(2026, 1, 2), LocalTime(3, 4, 5), UtcOffset(19815))
    assert formatIsoDateTime(value) == "2026-01-02T03:04:05+05:30:15" { "second-precision offsets must not be lost" }
}

test "ISO parser accepts UTC fractions" {
    fin value = parseIsoDateTime("2026-07-16T09:05:07.1234Z") catch DateTime(LocalDate(0, 1, 1), LocalTime(0, 0, 0), UtcOffset(0))
    assert value.date.year == 2026 && value.time.nanosecond == 123400000 { "fraction must be scaled to nanoseconds" }
}

test "ISO parser accepts signed offsets" {
    fin value = parseIsoDateTime("2026-07-16T09:05:07-05:30") catch DateTime(LocalDate(0, 1, 1), LocalTime(0, 0, 0), UtcOffset(0))
    assert value.offset.totalSeconds == -19800 { "negative offset parsing changed" }
}

test "ISO parser rejects malformed calendar text" {
    fin value = parseIsoDateTime("2026-02-30T09:05:07Z") catch DateTime(LocalDate(-1, 1, 1), LocalTime(0, 0, 0), UtcOffset(0))
    assert value.date.year == -1 { "invalid calendar dates must fail" }
}

test "ISO parser rejects invalid offset minutes" {
    fin value = parseIsoDateTime("2026-07-16T09:05:07+01:99") catch DateTime(LocalDate(-1, 1, 1), LocalTime(0, 0, 0), UtcOffset(0))
    assert value.date.year == -1 { "offset minutes above 59 must fail" }
}

test "ISO instant round trip preserves nanoseconds" {
    fin original = instant(1770000000, 987654321)
    fin restored = parseIsoInstant(original.formatIso()) catch Instant(0)
    assert restored.epochSecond == original.epochSecond { "epoch seconds must round trip" }
    assert restored.nanosecond == original.nanosecond { "nanoseconds must round trip" }
}

test "monotonic elapsed rejects reversed readings" {
    fin elapsed: MonotonicInstant = .(10).elapsedSince(MonotonicInstant(20)) catch Duration(-1)
    assert elapsed.seconds == -1 { "reversed monotonic readings must fail" }
}

test "monotonic elapsed returns exact duration" {
    fin elapsed: MonotonicInstant = .(2000000050).elapsedSince(MonotonicInstant(1000000000)) catch Duration(-1)
    assert elapsed.seconds == 1 && elapsed.nanosecondAdjustment == 50 { "monotonic elapsed time must be exact" }
}

test "instant serializer uses canonical ISO text" {
    fin serializer = InstantSerializer()
    fin tree = serializer.toSerialValue(Instant(0)) catch SerialValue.Null
    fin text = encodeSerialValue(tree, serializerOptions()) catch "error"
    assert text == "\"1970-01-01T00:00:00Z\"" { "Instant serializer wire form changed" }
}

test "date time serializer round trips offsets" {
    fin serializer = DateTimeSerializer()
    fin original = DateTime(LocalDate(2026, 7, 16), LocalTime(9, 5, 7, 42), UtcOffset(-12600))
    fin tree = serializer.toSerialValue(original) catch SerialValue.Null
    fin restored = serializer.fromSerialValue(tree) catch DateTime(LocalDate(0, 1, 1), LocalTime(0, 0, 0), UtcOffset(0))
    assert restored.date.year == 2026 && restored.offset.totalSeconds == -12600 { "DateTime serializer must preserve offset" }
    assert restored.time.nanosecond == 42 { "DateTime serializer must preserve nanoseconds" }
}

test "duration serializer preserves normalized fields" {
    fin serializer = DurationSerializer()
    fin original = duration(-2, 250000000)
    fin tree = serializer.toSerialValue(original) catch SerialValue.Null
    fin restored = serializer.fromSerialValue(tree) catch Duration(0)
    assert restored.seconds == original.seconds { "Duration serializer must preserve seconds" }
    assert restored.nanosecondAdjustment == original.nanosecondAdjustment { "Duration serializer must preserve nanoseconds" }
}

test "serializable metadata is present on portable time values" {
    inline assert reflect<Duration>.hasAnnot<Serializable> { "Duration must be serializable" }
    inline assert reflect<Instant>.hasAnnot<Serializable> { "Instant must be serializable" }
    inline assert reflect<LocalDate>.hasAnnot<Serializable> { "LocalDate must be serializable" }
    inline assert reflect<LocalTime>.hasAnnot<Serializable> { "LocalTime must be serializable" }
    inline assert reflect<UtcOffset>.hasAnnot<Serializable> { "UtcOffset must be serializable" }
    inline assert reflect<DateTime>.hasAnnot<Serializable> { "DateTime must be serializable" }
}

test "monotonic readings are intentionally not serializable" {
    inline assert !reflect<MonotonicInstant>.hasAnnot<Serializable> {
        "process-local monotonic readings must never become persisted timestamps"
    }
}

test .All "time"
