/**
 * @file std/parallelism/sync.az
 *
 * Synchronization patterns and primitives.
 *
 * Provides higher-level synchronization utilities built on top of
 * the language's atomic and mutex primitives: Guard for safe shared
 * state, CountDownLatch for coordination, and SpinLock for lightweight locking.
 *
 * @since 0.1
 */
@Supress(.Unused)
module std.parallelism.sync


// Sequentially consistent 32-bit atomics. Native LLVM uses aligned atomic
// instructions; the interpreter serializes access to the same storage word.
bridge func _atomicLoad(word: Int^): Int
bridge func _atomicStore(word: Int^, value: Int)
bridge func _atomicAdd(word: Int^, value: Int): Int
bridge func _atomicCas(word: Int^, expected: Int, replacement: Int): Bool

// Shared control blocks use these operations on live, aligned Int storage.
// The caller must keep the allocation alive until all operations finish.
func atomicLoadWord(word: Int^): Int { return _atomicLoad(word) }
func atomicAddWord(word: Int^, value: Int): Int { return _atomicAdd(word, value) }

pack Atomic {
    var _word: Int^ = alloc^ 0
}
impl Atomic {
    ctor .(initial: Int) { self._word[0] = initial }
    func &.load(): Int { return _atomicLoad(self._word) }
    func &.store(value: Int) { _atomicStore(self._word, value) }
    // Returns the value before the addition, like LLVM atomicrmw.
    func &.add(value: Int): Int { return _atomicAdd(self._word, value) }
    func &.cas(expected: Int, replacement: Int): Bool {
        return _atomicCas(self._word, expected, replacement)
    }
    dtor .() { purge self._word }
}

// An unfair, non-reentrant spin mutex. Critical sections must not suspend;
// callers use defer to release on every function exit.
pack Mutex { var _state: Atomic = .(0) }
impl Mutex {
    func &.lock() { while !self._state.cas(0, 1) {} }
    func &.unlock() { self._state.store(0) }
    dtor .() { purge self._state }
}

/**
 * A mutex-protected value that provides safe concurrent access.
 *
 * Guard wraps a value with a mutex, ensuring that reads and writes
 * are always performed under lock protection.
 *
 * @generic T The type of the protected value.
 */
@Since("0.1")
pack Guard<T> {
    var _mutex: Mutex = .()
    var _value: T
}

impl Guard<T> {
    /**
     * Reads the inner value under lock.
     *
     * @param action The function to execute with the current value.
     */
    @Experimental(since: "0.1")
    func &.read(action: (T) -> Unit) {
        self._mutex.lock()
        defer { self._mutex.unlock() }
        action(self._value)
    }

    /**
     * Modifies the inner value under lock.
     *
     * @param action The function that receives the current value and returns the new value.
     */
    @Experimental(since: "0.1")
    func !.write(action: (T) -> T) {
        self._mutex.lock()
        defer { self._mutex.unlock() }
        self._value = action(self._value)
    }

    /**
     * Returns a snapshot of the current value.
     *
     * @return The current value.
     */
    @Experimental(since: "0.1")
    func &.get(): T {
        self._mutex.lock()
        defer { self._mutex.unlock() }
        fin v = self._value
        return v
    }
}

/**
 * A coordination primitive that allows threads to wait until
 * a set of operations completes.
 *
 * @generic T The type of the count value.
 */
@Since("0.1")
pack CountDownLatch<T> {
    var count: T
    var _atomic: Atomic = .(0)
}

impl CountDownLatch<T> {
    /**
     * Decrements the latch count by one.
     */
    @Experimental(since: "0.1")
    func !.countDown() {
        self._atomic.add(1)
    }

    /**
     * Whether the latch count has been reached.
     */
    @Experimental(since: "0.1")
    prop &.isReached: Bool = self._atomic.load() >= self.count
}

/**
 * A lightweight CAS-based spin lock.
 *
 * SpinLock uses an atomic flag for minimal-overhead mutual exclusion.
 * Best suited for very short critical sections.
 *
 * @generic T Unused type parameter for template registration.
 */
@Since("0.1")
pack SpinLock<T> {
    var _flag: Atomic = .(0)
}

impl SpinLock<T> {
    /**
     * Acquires the lock, spinning until successful.
     */
    @Experimental(since: "0.1")
    func &.acquire() {
        while !self._flag.cas(0, 1) { }
    }

    /**
     * Releases the lock.
     */
    @Experimental(since: "0.1")
    func &.release() {
        self._flag.store(0)
    }

    /**
     * Executes an action while holding the lock.
     *
     * @param action The function to execute under lock.
     */
    @Experimental(since: "0.1")
    func &.withLock(action: () -> Unit) {
        self.acquire()
        defer { self.release() }
        action()
    }
}

/**
 * Executes an action under the given mutex lock.
 *
 * @param mutex The mutex to lock.
 * @param action The function to execute while holding the lock.
 */
@Experimental(since: "0.1")
func withMutex(mutex: Mutex&, action: () -> Unit) {
    mutex.lock()
    defer { mutex.unlock() }
    action()
}


test "atomic operations update one shared word" {
    var a = Atomic(3)
    assert a.load() == 3 panic "initial atomic value"
    assert a.add(2) == 3 && a.load() == 5 panic "fetch add"
    assert !a.cas(3, 9) && a.load() == 5 panic "failed compare exchange"
    assert a.cas(5, 7) && a.load() == 7 panic "successful compare exchange"
    a.store(11)
    assert a.load() == 11 panic "atomic store"
    purge a
}
