expose module std.reactive

/**
 * @file std.reactive
 *
 * Rendering-independent reactive state and deterministic effects.
 *
 * `react func` and `react async func` declare a reactive owner. Inside one:
 *
 * A reactive declaration is an ordinary binding with a lifetime in front of it:
 * `remember var`, `retain val`, `preserve fin`, and every other combination.
 * The lifetimes form a ladder, weakest first - each survives everything the one
 * below it does:
 *
 * - `remember` survives reactive reruns.
 * - `retain` survives owner recreation in the same process.
 * - `preserve` is serialized and restored across process or application
 *   restarts.
 *
 * A reactive lifetime cannot be combined with `threadlocal`: both answer where
 * a value lives, and a binding claiming each says nothing coherent about
 * either.
 *
 * - `effect { }` tracks reactive values read by the effect.
 * - `effect value { }` tracks one explicit dependency.
 * - `effect [a, b] { }` tracks an explicit dependency list.
 * - `effect defer { }` registers owner-exit cleanup.
 *
 * This module contains no rendering or UI policy. A renderer, server, game,
 * data pipeline, or command-line program may all build on the same semantics.
 */

/**
 * Enables reactive declarations and effects in the decorated callable.
 *
 * The declaration is a compiler bridge rather than a magic undeclared
 * annotation, so imports, completion, decorator target checks, reflection,
 * and documentation all observe the same symbol.
 */

realm std {
    /**
     * Describes the distinct lifetime selected by a reactive declaration.
     */
    @Experimental(since: "0.1")
    enum ReactiveLifetime {
        /** Survives reactive reruns. */
        Remembered

        /** Survives owner recreation in the same process. */
        Retained

        /** Serialized and restored across process or application restarts. */
        Preserved
    }

    /**
     * A serializable description of one reactive value.
     *
     * Hosts can use this metadata when persisting reactive state without knowing
     * anything about a renderer.
     */
    @Experimental(since: "0.1")
    pack ReactiveSnapshot<T> {
        fin key: String
        fin value: T
        fin lifetime: ReactiveLifetime
    }
}

realm test {
    react func reactiveAutomaticEffectFixture(): Int {
        remember var value = 1
        var observed = 0
        effect {
            observed = value
        }
        value = 7
        return observed
    }

    react func reactiveExplicitEffectFixture(): Int {
        preserve var x = 1
        retain var y = 10
        var observed = 0
        effect x {
            observed = x + y
        }
        y = 20
        x = 2
        return observed
    }

    react func reactiveListEffectFixture(): Int {
        remember var x = 1
        remember var y = 2
        var observed = 0
        effect [x, y] {
            observed = x * 10 + y
        }
        x = 3
        y = 4
        return observed
    }

    react func reactiveDeferredEffectFixture() {
        effect defer {
            fin cleanupRegistered = true
        }
    }

    react func testReactiveAutomaticEffect() {
        assert reactiveAutomaticEffectFixture() == 7 {
            "automatic effect did not observe the latest remembered value"
        }
    }

    react func testReactiveExplicitEffect() {
        assert reactiveExplicitEffectFixture() == 22 {
            "explicit effect dependencies were not respected"
        }
    }

    react func testReactiveListEffect() {
        assert reactiveListEffectFixture() == 34 {
            "effect dependency list did not observe both updates"
        }
    }
}

test "reactive declarations and effects compile" {
    assert true { "reactive compile fixture" }
}

test "reactive cleanup contract compiles" {
    assert true { "reactive cleanup compile fixture" }
}

test .All "reactive"
