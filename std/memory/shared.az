module std.memory.shared

/**
 * @file std/memory/shared
 *
 * A shared pointer counted on one thread (`Shared<T>`).
 *
 * One heap allocation, many owners: `retain()` records a new owner, `release()`
 * gives one up and reclaims the allocation when the last one leaves.
 *
 * The count is a plain integer, so handing a `Shared` to another thread races on
 * it — two owners releasing at once can both read the same count and free twice,
 * or neither can and the allocation leaks. Use [std::SyncShared] when the owners
 * are not all on one thread; this type exists because most of them are, and the
 * synchronisation is not free.
 *
 * @since 0.0.5
 */

realm std {
    /**
     * A reference-counted pointer to a `T`, counted without synchronisation.
     *
     * @generic T the pointee type.
     */
    @Experimental(since: "0.0.5")
    pack Shared<T> {
        var raw: T*
        var count: Int
    }

    @Experimental(since: "0.0.5")
    oper.* [self: Shared<T>&]: T {
        return self.raw.*
    }

    /**
     * Cloning a `Shared` produces another owner of the *same* value — it does
     * not duplicate the pointee. It is never `Copy`: a new owner is a change to
     * the reference count, and the model keeps that visible at the call site.
     *
     * The count is adjusted by `retain`/`release`, which take an exclusive
     * receiver; `clone` borrows shared, so a caller that keeps the clone past
     * the original's lifetime pairs it with a `retain`.
     */
    @Since("0.0.5")
    impl Clone for Shared<T> {
        func clone[self: Self&]() {
            return Shared<T>(self.raw, self.count)
        }
    }

    impl Shared<T> {
        /** The pointed-to value. */
        @Experimental(since: "0.0.5")
        prop get[self: Self&]: T = self.raw.*

        /** Replaces the pointed-to value without changing ownership. */
        @Experimental(since: "0.0.5")
        func set(value: T) { self.raw[0] = value }

        /** Records a new shared owner. Returns the new reference count. */
        @Experimental(since: "0.0.5")
        func retain(): Int {
            self.count = self.count + 1
            return self.count
        }

        /** Gives up one owner; reclaims the allocation when the last one leaves. */
        @Experimental(since: "0.0.5")
        func release(): Int {
            self.count = self.count - 1
            if self.count <= 0 {
                purge self.raw
            }
            return self.count
        }

        /** The current number of live references. */
        @Experimental(since: "0.0.5")
        prop refCount[self: Self&]: Int = self.count

        /** The underlying `T*` (escapes the counting). */
        @Experimental(since: "0.0.5")
        prop ptr[self: Self&]: T* = self.raw
    }

    /** A `Shared<T>` owning a fresh copy of [value], with one live reference. */
    @Experimental(since: "0.0.5")
    func sharedOf<T>(value: T): Shared<T> {
        return Shared(alloc value, 1)
    }
}
