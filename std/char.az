/**
 * @file std/char.az
 *
 * Character utilities and Unicode support.
 *
 * Provides functions for character classification, conversion,
 * and Unicode code point manipulation. Characters in Azora are
 * Unicode code points represented by the Char type.
 *
 * @since 0.1
 */
@Supress(.Unused)
exposed module std.char

import std.traits::{PartialEqual, Equal, Order, Hash}

/**
 * A Unicode code point.
 *
 * Ordered by code point, which is an order and not a collation - a
 * locale-aware comparison is a function with a locale parameter and never what
 * `<` does.
 */
@Since("0.1")
bridge pack Char derives (PartialEqual, Equal, Order, Hash)

