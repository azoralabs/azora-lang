/**
 * @file std/algorithm/algorithm.az
 *
 * Additional algorithm utilities: merge sort, sortBy, groupBy, etc.
 *
 * @since 0.1
 */
@Supress(.Unused)
module std.algorithm

import std.container.array::*
import std.traits::Order

/**
 * Merge sort - O(n log n) stable sorting algorithm.
 */
@Experimental(since: "0.1")
func mergeSort<T>(arr: Array<T>): Array<T> {
    if arr.size <= 1 {
        return arr
    }
    var mid: Int = arr.size / 2
    var left: Array<T> = .() * mid
    var right: Array<T> = .() * arr.size - mid
    for i: Int in 0..mid {
        left[i] = arr[i]
    }
    for j: Int in 0..arr.size {
        right[j] = arr[i]
        i++
    }
    var sortedLeft: Array<T> = mergeSort(left)
    var sortedRight: Array<T> = mergeSort(right)
    return merge(sortedLeft, sortedRight)
}

/**
 * Merges two sorted arrays into one sorted array.
 */
@Experimental(since: "0.1")
func merge<T: Order>(a: Array<T>, b: Array<T>): Array<T> {
    var result: Array<T> = .() * a.size + b.size
    var [ri, ai, bi] = 0
    while ai < a.size && bi < b.size {
        if a[ai] <= b[bi] {
            result[ri] = a[ai]
            ai++
        } else {
            result[ri] = b[bi]
            bi++
        }
        ri++
    }
    while ai < a.size {
        result[ri] = a[ai]
        ai++
        ri++
    }
    while bi < b.size {
        result[ri] = b[bi]
        bi++
        ri++
    }
    return result
}

/**
 * Sorts by a key extracted from each element.
 *
 * The key is its own type: sorting people by age means a `(Person) -> Int`,
 * and a key function forced to return the element type could not express
 * that at all. `K` need only be [Order] - the element type need not be
 * ordered, which is the point of sorting by a key.
 *
 * Stable, and O(n log n) - the same bottom-up merge [sort] uses, carrying
 * the computed keys alongside the elements so a key is never recomputed
 * mid-sort.
 *
 * @param arr The array to sort.
 * @param key Extracts the value to order by.
 * @return A new array ordered by [key]; the original is unchanged.
 */
@Experimental(since: "0.1")
func sortBy<T, K>(arr: Array<T>, key: (T) -> K): Array<T> where K: Order
out {
    assert it.size == arr.size { "sortBy must preserve length" }
} scope {
    fin count = arr.size
    var result: Array<T> = .() * count
    for i: Int in 0..<count {
        result[i] = arr[i]
    }
    if count <= 1 {
        return result
    }

    // Keys are computed once per element rather than once per comparison:
    // a key function may be arbitrarily expensive, and a comparison sort
    // asks O(n log n) times.
    var keys: Array<K> = .() * count
    for i: Int in 0..<count {
        keys[i] = key(result[i])
    }

    var width: Int = 1
    var scratch: Array<T> = .() * count
    var scratchKeys: Array<K> = .() * count
    while width < count {
        for lo: Int in 0..count {
            var mid = lo + width
            if mid > count {
                mid = count
            }
            var hi = lo + width + width
            if hi > count {
                hi = count
            }
            var left = lo
            var right = mid
            var at = lo
            while at < hi {
                fin takeLeft: Bool = if left >= mid {
                    false
                } else if right >= hi {
                    true
                } else {
                    // `<=` on the left key: ties keep the earlier element,
                    // which is what makes this stable.
                    keys[left] <= keys[right]
                }
                if takeLeft {
                    scratch[at] = result[left]
                    scratchKeys[at] = keys[left]
                    left++
                } else {
                    scratch[at] = result[right]
                    scratchKeys[at] = keys[right]
                    right++
                }
                at++
            }
            lo = lo + width + width
        }
        for i: Int in 0..<count {
            result[i] = scratch[i]
            keys[i] = scratchKeys[i]
        }
        width *= 2
    }
    return result
}

/**
 * Groups elements by a key function.
 * Returns array of arrays where each sub-array has elements with the same key.
 */
@Experimental(since: "0.1")
func groupBy<T>(arr: Array<T>, key: (T) -> T): Array<T> {
    var keys: Array<T> = .() * arr.size
    var groups: Array<T> = .() * arr.size
    var keyCount = 0
    for i in 0..<arr.size {
        var k: T = key(arr[i])
        var found = -1
        for j in 0..<keyCount {
            if keys[j] == k {
                found = j
            }
        }
        if found == -1 {
            keys[keyCount] = k
            groups[keyCount] = @arr[arr[i]]
            keyCount++
        } else {
            var g: Array<T> = groups[found]
            g[g.size] = arr[i]
            groups[found] = g
        }
    }
    // Trim groups to actual count
    var trimmed: Array<T> = .() * keyCount
    for ti in 0..<keyCount {
        trimmed[ti] = groups[ti]
    }
    return trimmed
}

/**
 * Interleaves two arrays: [a1, b1, a2, b2, ...].
 */
@Experimental(since: "0.1")
func interleave<T>(a: Array<T>, b: Array<T>): Array<T> {
    var result: Array<T> = .() * a.size + b.size
    var ri = 0
    var maxLen: Int = a.size
    if b.size > maxLen {
        maxLen = b.size
    }
    for i in 0..<maxLen {
        if i < a.size {
            result[ri] = a[i]
            ri++
        }
        if i < b.size {
            result[ri] = b[i]
            ri++
        }
    }
    return result
}

/**
 * Returns a sliding window of given size over the array.
 */
@Experimental(since: "0.1")
func windows<T>(arr: Array<T>, size: Int): Array<T> {
    fin count = if arr.size >= size {
        arr.size - size + 1
    } else {
        0
    }
    var result: Array<T> = .() * count
    var ri = 0
    var i = 0
    while i + size <= arr.size {
        var w: Array<T> = .() * size
        for j in 0..<size {
            w[j] = arr[i + j]
        }
        result[ri] = w
        ri++
        i++
    }
    return result
}

/**
 * Returns array with elements at even indices.
 */
@Experimental(since: "0.1")
func evens<T>(arr: Array<T>): Array<T> {
    fin count = (arr.size + 1) / 2
    var result: Array<T> = .() * count
    var ri = 0
    var i = 0
    while i < arr.size {
        result[ri] = arr[i]
        ri++
        i += 2
    }
    return result
}

/**
 * Returns array with elements at odd indices.
 */
@Experimental(since: "0.1")
func odds<T>(arr: Array<T>): Array<T> {
    fin count = arr.size / 2
    var result: Array<T> = .() * count
    var ri = 0
    var i = 1
    while i < arr.size {
        result[ri] = arr[i]
        ri++
        i += 2
    }
    return result
}
