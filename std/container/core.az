@Supress(.Unused)
exposed module std.container.core

/**
 * Builds a fixed-size [Array].
 *
 * @1 `@arr[1, 2, 3]` expands to `std.container.array::Array<Int>(1, 2, 3)`.
 */
macro @arr[...$items] => std.container.array::Array(...$items) // generic will infer from first item type

/**
 * Builds an immutable [List].
 *
 * @1 `@vec[1, 2, 3]` expands to `std.container.list::ArrayList<Int>(1, 2, 3)`.
 * @2 `@vec![1, 2, 3]` expands to `std.container.list::MutableArrayList<Int>(1, 2, 3)`.
 */
macro @vec {
    [...$items] => std.container.list::ArrayList(...$items)
    //![...$items] => std.container.list::MutableArrayList(...$items)
}

/**
 * Builds an immutable [Set].
 *
 * @0 `@set[]` expands to `emptySet()`.
 * @1 `@set[1, 2, 3]` expands to `setOf(1, 2, 3)`.
 */
macro @set {
    [] => emptySet()
    [...$items] => setOf(...$items)
}

/**
 * Builds a mutable [Set].
 *
 * @0 `@set![]` expands to `emptyMutableSet()`.
 * @1 `@set![1, 2, 3]` expands to `mutableSetOf(1, 2, 3)`.
 */
macro @set! {
    [] => emptyMutableSet()
    [...$items] => mutableSetOf(...$items)
}

/**
 * Builds an immutable [Map].
 *
 * @0 `@map[]` expands to `emptyMap()`.
 * @1 `@map["One": 1, "Two": 2]` expands to `mapOf("One" to 1, "Two" to 2)`.
 */
macro @map {
    [] => emptyMap()
    [...${key: value}] => mapOf(...mapEntry($key, $value))
}

/**
 * Builds a mutable [Map].
 *
 * @0 `@map![]` expands to `emptyMutableMap()`.
 * @1 `@map!["One": 1]` expands to `mutableMapOf("One" to 1)`.
 */
macro @map! {
    [] => emptyMutableMap()
    [...${key: value}] => mutableMapOf(...mapEntry($key, $value))
}

/**
 * Builds a [Deque].
 *
 * @1 `@deq[1, 2, 3]` expands to `Deque<T>(1, 2, 3)`.
 */
macro @deq {
    [] => std.container.deque::Deque()
}
