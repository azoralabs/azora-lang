/**
 * @file std/core.az
 *
 * Compiler-predefined declarations available in every Azora module: the
 * primitive `bridge pack` types, the `Reflected<T>` reflection handle, the core.az
 * decorators, and the `bridge func` string/char intrinsics. These are compiler-
 * provided and never dispatch at runtime.
 */
@Supress(.Unused)
exposed module std.core

@Since("0.1")
bridge pack Unit

/**
 * The bottom type: no value has it, and nothing can be read at it.
 *
 * What a compile-time computation answers when the question it was asked has
 * none - the type of a default that was never declared, say. `Unit` would be
 * the wrong answer there: it says there *is* a value and it happens to carry
 * nothing, where `Nothing` says there is no value at all.
 */
@Since("0.1")
bridge pack Nothing

/**
 * The erased top type accepted by APIs that can receive values of any type.
 *
 * `Any` is compiler-provided: it has no constructible runtime pack and each
 * backend uses its native erased value representation.
 */
@Since("0.1")
bridge pack Any

@Since("0.1")
bridge pack Self

/**
 * The compile-time meta-type: the type of a type. Used as the element type of
 * type lists (`[Type]`) and as the parameter type of `type` functions
 * (`type promote(T: ...Type)`).
 */
@Since("0.1")
bridge pack Type

/**
 * The type's own name, as a string: `T.typeName` is `"Position"` where `T`
 * was bound to `Position`.
 *
 * The receiver is written as a type because there is no value to read it
 * from - the member belongs to the type itself. Folded where `T` stops
 * being a parameter, which is the only place the answer exists: nothing
 * afterwards remembers what a caller chose.
 */
impl Type {
    /**
     * The type's own name, as a string: `T.typeName` is `"Position"` where
     * `T` was bound to `Position`.
     *
     * Folded where `T` stops being a parameter - an inline call site, or a
     * specialization - which is the only place the answer exists: a type
     * parameter has no name of its own, only the name of whatever a caller
     * chose for it, and nothing afterwards remembers which that was.
     */
    @Since("0.1")
    bridge deepinline prop typeName[&]: String
}

@Since("0.1")
variant enum Option<T> {
    Some(T)
    None
}

deepinline func Nullable<T>(b: Bool): Type {
    return when b {
        true => Option<T?>
        false => Option<T>
    }
}

/** Declaration categories accepted by decorator `for` constraints. */
@Experimental(since: "0.1")
bridge enum DecoTarget {
    Pack, Func, AsyncFunc, Prop, AsyncProp, Enum, VariantEnum, EnumValue
    Error, VariantError, ErrorValue, UnsafeUnion, UnionValue, Annot
    Field, Param, Var, Let, Val, Fin, Test, Module
    Ctor, Dtor, TypeAlias, Bridge, Oper
}

/** Controls whether a test runs its own body or aggregates its source file. */
@Experimental(since: "0.1")
bridge enum TestMethod {
    /** Runs only this test body. This is the default. */
    This
    /** Runs every `This` test declared in the same source file. */
    All
}

/**
 * The result of `<=>` on a totally ordered type.
 *
 * Total means every pair of values relates: for any `a` and `b` exactly one
 * of `Less`, `Equal`, `Greater` holds, and the relation is transitive. A
 * type whose `<=>` answers `Compare` is making that promise - see [Order].
 */
@Since("0.1")
enum Compare {
    Less
    Equal
    Greater
}

/**
 * The result of `<=>` on a partially ordered type.
 *
 * `Unordered` is the fourth answer a total order does not have: the two
 * values are neither less, nor greater, nor equal. `Double.NAN` against
 * anything is the case that forces this type to exist, and it is why the
 * relational operators derived from a `PartialCompare` are *all* false for
 * such a pair rather than the negation of one another.
 */
@Since("0.1")
enum PartialCompare {
    Less
    Equal
    Greater
    Unordered
}

/**
 * The relational operators of a total order.
 *
 * `a < b` is rewritten to `(a <=> b).isLess` and its three siblings likewise,
 * so this is where the meaning of `<`, `<=`, `>` and `>=` actually lives for
 * every type that declares `<=>`. Writing them here rather than in the
 * compiler is what keeps [Compare] and [PartialCompare] free to disagree -
 * and they do, on every one of the four.
 *
 * A total order has three answers, so the "or equal" forms are the negation
 * of their opposite.
 */
@Since("0.1")
impl Compare {
    prop isLess[self&]: Bool = self == .Less
    prop isLessOrEqual[self&]: Bool = self != .Greater
    prop isGreater[self&]: Bool = self == .Greater
    prop isGreaterOrEqual[self&]: Bool = self != .Less

    /** The comparison with its operands swapped. `Less` becomes `Greater`. */
    prop reversed[self&]: Compare {
        return when self {
            .Less -> .Greater
            .Greater -> .Less
            else -> .Equal
        }
    }

    /** `self` when it is decisive, otherwise `next`. Lexicographic chaining. */
    func then[self&](next: Compare): Compare {
        return if self == .Equal { next } else { self }
    }
}

/**
 * The relational operators of a partial order.
 *
 * Every one of the four differs from [Compare]'s. With four answers the
 * negated forms are wrong: `!= Greater` would make `NaN <= 1.0` true, so
 * each operator is written positively and `Unordered` makes all four false.
 * That is what IEEE 754 requires, and getting it right once here means no
 * user writes it again.
 */
@Since("0.1")
impl PartialCompare {
    prop isLess[self&]: Bool = self == .Less
    prop isLessOrEqual[self&]: Bool = self == .Less || self == .Equal
    prop isGreater[self&]: Bool = self == .Greater
    prop isGreaterOrEqual[self&]: Bool = self == .Greater || self == .Equal

    /** True when the two values do not relate at all. */
    prop isUnordered[self&]: Bool = self == .Unordered

    /** The comparison with its operands swapped. `Unordered` stays unordered. */
    prop reversed[self&]: PartialCompare {
        return when self {
            .Less -> .Greater
            .Greater -> .Less
            .Unordered -> .Unordered
            else -> .Equal
        }
    }

    /**
     * `self` when it is decisive, otherwise `next`.
     *
     * `Unordered` is decisive: a lexicographic order over a partial one is
     * unordered as soon as any field is.
     */
    func then[self&](next: PartialCompare): PartialCompare {
        return if self == .Equal { next } else { self }
    }
}

/**
 * Converts `Self` into a `T`.
 *
 * The receiver is declared in brackets like every other member. The member
 * is named `into` - the canonical name of the direction - and `use as`
 * names the call-site alias it generates: for `T = String` that is
 * `.toString`, for `T = Int` it is `.toInt`.
 *
 * ```azora
 * impl Into<String> for Label {
 *     func into[self: Self&](): String { return "Label(" + self.value + ")" }
 * }
 * label.toString      // the `use as` alias
 * ```
 *
 * @generic T target type produced by the conversion.
 */
@Experimental(since: "0.1")
spec Into<T> {
    prop into<T>[self: Self&]: T

    /**
     * The conversion under a name that says what it converts *to*.
     *
     * `inline` because nothing is generated: the name is expanded where the
     * spec is applied, so `Into<String>` makes `into` reachable as
     * `toString` and there is no second member to dispatch to.
     */
    inline prop to${T.typeName}: T = into<T>
}

/**
 * Builds a `Self` from a `T` - the canonical direction.
 *
 * `From` is what `Into` cannot express: it *constructs* rather than
 * consumes, so there is no `self` to convert and its member is a **static**.
 * A receiver-less `func` in a spec asks for exactly that, and
 * `impl From<T> for Type::` supplies it.
 *
 * It carries no `use as`: the member is reached as `Type::from`, which is
 * already the name callers write, so there is no alias to generate.
 *
 * ```azora
 * impl From<String> for Username:: {
 *     func from(value: return String): Self {
 *         return Username(value: take value)
 *     }
 * }
 * fin username: Username = Username::from(lend text)
 * ```
 *
 * @generic T source type the value is built from.
 */
@Experimental(since: "0.1")
spec From<T> {
    func from(value: T): Self
}

/**
 * Converts to `To` - what `value as To` calls.
 *
 * Total: a `Cast` cannot fail. Representational rather than semantic, so it
 * never takes ownership and never allocates - that is [Into]'s job, and the
 * line between them is what `DIPs/CAST_DIP.MD` is built on.
 *
 * The target is a parameter of the *impl*, not of the operator, so each one
 * gets a body the compiler can check and `where T: Cast<String>` is
 * expressible.
 *
 * The spec is `bridge`, and `castValue` is a compiler protocol member.
 * Source code writes `value as To`; the compiler resolves that syntax to
 * this member before ordinary member lookup.
 */
@Since("0.1")
bridge spec Cast<TO> {
    prop castValue<TO>[self: Self&]: TO
}

/**
 * Converts to `To` when the value permits it - what `value as? To` calls.
 *
 * Does **not** require [Cast]: a conversion that can fail is precisely the
 * one with no infallible form.
 */
@Since("0.1")
bridge spec CheckedCast<TO> {
    prop castValue<TO>[self: Self&]: TO?
}

/**
 * Reinterprets the bits as a `To` - what `value as* To` calls.
 *
 * Requires equal sizes, checked at the lowering site. Requires neither of
 * the others: a reinterpretation is not a conversion.
 */
@Since("0.1")
bridge spec BitCast<TO> {
    prop castValue<TO>[self: Self&]: TO
}

@Experimental(since: "0.1")
bridge enum LogLevel {
    /** Detailed diagnostic information. The default level for `trace`. */
    Debug

    /** Normal progress or lifecycle information. */
    Info

    /** A recoverable problem that deserves attention. */
    Warn

    /** A failed operation. */
    Error

    /** A severe failure that may prevent continued execution. */
    Critical

    /** A trace marking unfinished implementation work. */
    Todo
}

/**
 * Backend targets a `bridge` block or `bridge func`/`bridge pack` declaration may
 * address. `Compiler` (the first, default value) means the declaration is provided
 * directly by the compiler; the rest are foreign-function targets. A bare `bridge`
 * (e.g. `bridge func`) uses this default, exactly as `test` defaults to the first
 * `TestMethod`.
 */
@Experimental(since: "0.1")
bridge enum Target {
    Compiler
    C
    ObjectiveC
    WebAssembly
}

/** Marks an API as stable from the optional semantic version onward. */
@Experimental(since: "0.1")
bridge annot @Stable {
    fin since: String = ""
}

/** Marks an API as experimental from the optional semantic version onward. */
@Experimental(since: "0.1")
bridge annot @Experimental {
    fin since: String = ""
}

/** Records the first released version containing a declaration. */
@Experimental(since: "0.1")
bridge annot @Since {
    fin version: String
}

/** Marks an API as deprecated and optionally names its replacement. */
@Experimental(since: "0.1")
bridge annot @Deprecated {
    fin since: String = ""
    fin replacement: String = ""
}

/** Allows compile-time generated packs to declare numeric field names. */
@Experimental(since: "0.1")
bridge annot @EnforceNumFields for .Pack

@Experimental(since: "0.1")
bridge annot @UncheckedCast for [.Func, .AsyncFunc, .Prop, .AsyncProp, .Var, .Fin, .Oper]

/**
 * Marks a function that may only be reached through a signature.
 *
 * A function so marked is unreachable from the body of anything whose
 * decorator is [DeclaresAccess]: what it hands back is asked for as a
 * parameter instead. Acquiring something mid-body hides it from every
 * reader of the signature, and from anything that decides - from signatures
 * alone - which of two callers may run beside the other.
 */
@Experimental(since: "0.1")
bridge annot @SignatureOnly for [.Func, .AsyncFunc]

/**
 * Marks a function that carries out access a parameter already declares.
 *
 * The reach of a [DeclaresAccess] body stops here. A system asking for
 * `shapes: @query […]` has declared what it touches; what the query does to
 * serve that is the declaration being honoured, not access smuggled past
 * it. Without this the walk would follow a declared parameter into its own
 * implementation and refuse it there.
 */
@Experimental(since: "0.1")
bridge annot @ProvidesAccess for [.Func, .AsyncFunc, .Prop]

/**
 * Marks a decorator whose functions declare their access in their signature.
 *
 * A function carrying such a decorator states everything it touches in its
 * parameters, so a [SignatureOnly] call in its body is refused. The two
 * decorators are halves of one rule: this names the boundary, and
 * `SignatureOnly` names what may not cross it.
 */
@Experimental(since: "0.1")
bridge annot @DeclaresAccess for .Annot

/**
 * Connects a library decorator to a compiler derive generator.
 *
 * `generator` selects an installed generator and `role` describes how that
 * decorator participates in it. Libraries opt in explicitly; generators do
 * not depend on library module paths or decorator names.
 */
@Experimental(since: "0.1")
bridge annot @Derive for .Annot {
    fin generator: String
    fin role: String
    fin provider: String = ""
    fin conversionProvider: String = ""
    fin providerModule: String = ""
    fin conversionModule: String = ""
    fin deferGeneric: Bool = false

    /** The module declaring the list type generated code builds. */
    fin listModule: String = ""
}

@Since(version: "0.1")
bridge enum SupressKind {
    Unused
}

@Experimental(since: "0.1")
bridge annot @Supress for .* {
    fin kind: SupressKind
}

/** Number of characters in `value`. */
@Experimental(since: "0.1")
bridge func stringLength(value: String): Int

/** Character at zero-based `index`. */
@Experimental(since: "0.1")
bridge func charAt(value: String, index: Int): Char

/** Text from `start` inclusive to `end` exclusive. */
@Experimental(since: "0.1")
bridge func substring(value: String, start: Int, end: Int): String

/** Unicode scalar value represented by `value`. */
@Experimental(since: "0.1")
bridge func ord(value: Char): Int

/** Character represented by a valid Unicode scalar value. */
@Experimental(since: "0.1")
bridge func chr(value: Int): Char

/** Whether `value` is an ASCII decimal digit. */
@Experimental(since: "0.1")
bridge func isDigit(value: Char): Bool

/** Whether `value` starts with `prefix`. */
@Experimental(since: "0.1")
bridge func startsWith(value: String, prefix: String): Bool

/** Whether `value` ends with `suffix`. */
@Experimental(since: "0.1")
bridge func endsWith(value: String, suffix: String): Bool

/** Whether `value` contains `sub`. */
@Experimental(since: "0.1")
bridge func contains(value: String, sub: String): Bool

/** First index of `sub` in `value`, or `-1` when absent. */
@Experimental(since: "0.1")
bridge func indexOf(value: String, sub: String): Int

/** `value` with leading and trailing whitespace removed. */
@Experimental(since: "0.1")
bridge func trim(value: String): String

/** `value` with every character upper-cased. */
@Experimental(since: "0.1")
bridge func toUpper(value: String): String

/** `value` with every character lower-cased. */
@Experimental(since: "0.1")
bridge func toLower(value: String): String

/** `value` with each occurrence of `old` replaced by `new`. */
@Experimental(since: "0.1")
bridge func replace(value: String, old: String, new: String): String

/** `value` split on each occurrence of `delim`. */
@Experimental(since: "0.1")
bridge func split(value: String, delim: String): Array<String>

/** The characters of `value` as an array. */
@Experimental(since: "0.1")
bridge func toChars(value: String): Array<Char>

/** A string built by concatenating `chars` in order. */
@Experimental(since: "0.1")
bridge func fromChars(chars: Array<Char>): String

/** Whether `value` is an ASCII alphabetic character. */
@Experimental(since: "0.1")
bridge func isAlpha(value: Char): Bool

/**
 * Preserves a backend symbol exactly while deriving its Azora-facing name.
 *
 * Declaration-position bridge macros return the backend and local names. The
 * compiler supplies `target`, allowing this macro to use UpperCamel for type
 * declarations and lowerCamel for value declarations while preserving the
 * exact linked or exported symbol.
 */
macro @foreignName { target ->
    ($name: String) =>
        $name
        inline if target.isType {
            $name.upperCamel
        } else {
            $name.lowerCamel
        }
}
