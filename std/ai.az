/**
 * @file std/ai.az
 *
 * Structured model-facing APIs. Values are ordinary Azora data; calls that
 * contact a provider or accelerator are explicit bridge operations.
 *
 * @since 0.1
 */
@Supress(.Unused)
module std.ai

import std.container.list::ArrayList

/** The origin of a message in a structured model conversation. */
@Experimental(since: "0.1")
enum Role {
    System
    User
    Assistant
    Tool
}

/** One role-labelled message. */
@Experimental(since: "0.1")
pack Message {
    var role: Role
    var content: String
    var name: String
}

/** An ordered conversation; the application owns its lifecycle. */
@Experimental(since: "0.1")
pack Conversation {
    var messages: ArrayList<Message>
}

/** Provider-neutral generation controls. */
@Experimental(since: "0.1")
pack GenerationOptions {
    var maxTokens: Int = 1024
    var temperature: Double = 0.0
    var topP: Double = 1.0
    var seed: Int = -1
    var allowTools: Bool = false
}

/** A capability an application may explicitly offer to a model. */
@Experimental(since: "0.1")
pack ToolSpec {
    var name: String
    var description: String
    var schema: String
}

/** Opaque provider/model connection. */
@Experimental(since: "0.1")
bridge pack AiModel

/** Creates an empty conversation. */
@Experimental(since: "0.1")
prop conversation: Conversation = .(ArrayList<Message>())

impl Conversation {
    /** Appends one structured message. */
    @Experimental(since: "0.1")
    func !.add(message: Message): Unit {
        self.messages.add(message)
    }

    /** Returns the number of messages currently stored. */
    @Experimental(since: "0.1")
    prop &.size: Int = self.messages.size
}

/** Connects to a provider/model pair; the selected backend supplies it. */
@Experimental(since: "0.1")
bridge func connect(provider: String, model: String): AiModel

/** Generates one assistant message from structured conversation data. */
@Experimental(since: "0.1")
bridge func complete(
    model: AiModel,
    conversation: Conversation,
    options: GenerationOptions,
): Message

/** Produces an embedding vector for one input string. */
@Experimental(since: "0.1")
bridge func embed(model: AiModel, text: String): Array<Double>

/** Performs one simple system/user request through the explicit bridge. */
@Experimental(since: "0.1")
func ask(
    model: AiModel,
    system: String,
    question: String,
    options: GenerationOptions,
): Message {
    var chat = conversation
    chat.system(system)
    chat.user(question)
    return complete(model, chat, options)
}
