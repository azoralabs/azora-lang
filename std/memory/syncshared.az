/**
 * Shared ownership using one counter allocation for every cloned handle.
 * The counter uses sequentially consistent atomics; pointee access is not synchronized.
 * Cleanup is explicit through release() or purge until automatic scope destruction
 * is implemented. Each handle tracks its own retained references to prevent a
 * released handle from decrementing another owner's reference.
 */
@Supress(.Unused)
module std.memory.syncshared

import std.traits::Clone
import std.parallelism.sync

@Experimental(since: "0.1")
pack SyncShared<T> {
    var raw: T^
    var count: Int^
    var _references: Int = 1
}

oper.* SyncShared<T>&.(): T {
    assert self._references > 0 panic "Shared owner was released"
    return self.raw.*
}

impl Clone for SyncShared<T> {
    func &.clone(): SyncShared<T> {
        assert self._references > 0 panic "Shared owner was released"
        atomicAddWord(self.count, 1)
        return SyncShared<T>(self.raw, self.count, 1)
    }
}

impl SyncShared<T> {
    prop &.get: T {
        assert self._references > 0 panic "Shared owner was released"
        return self.raw.*
    }

    // An exclusive handle alone does not establish exclusive pointee access.
    // Callers must ensure that no other handle accesses the pointee concurrently.
    func !.set(value: T) {
        assert self._references > 0 panic "Shared owner was released"
        self.raw[0] = value
    }

    // Records an extra reference held by this handle; pair it with release().
    func !.retain(): Int {
        assert self._references > 0 panic "Shared owner was released"
        atomicAddWord(self.count, 1)
        self._references = self._references + 1
        return atomicLoadWord(self.count)
    }

    func !.release(): Int {
        assert self._references > 0 panic "Shared owner was released"
        self._references = self._references - 1
        fin previous = atomicAddWord(self.count, -1)
        fin remaining = previous - 1
        if remaining == 0 {
            purge self.raw
            purge self.count
        }
        return remaining
    }

    prop &.refCount: Int {
        assert self._references > 0 panic "Shared owner was released"
        return atomicLoadWord(self.count)
    }

    prop &.ptr: T* {
        assert self._references > 0 panic "Shared owner was released"
        return self.raw
    }

    dtor .() {
        while self._references > 0 { self.release() }
    }
}

func<T> syncSharedOf(value: T): SyncShared<T> {
    return SyncShared(alloc^ value, alloc^ 1, 1)
}


test "cloned handles share the owner count" {
    var first = syncSharedOf(42)
    var second = first.clone()
    assert first.refCount == 2 && second.refCount == 2 panic "shared control block"
    assert first.release() == 1 panic "original releases one owner"
    assert second.get == 42 && second.refCount == 1 panic "clone remains alive"
    purge first
    purge second
}
