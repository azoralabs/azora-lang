mod std.memory.weak

/**
 * @file std/memory/weak
 *
 * Non-owning pointer view. It never drops memory; callers must prove the
 * pointee outlives the weak view.
 *
 * @since 0.0.3
 */

zone std {
    @SinceAzora("0.0.3")
    pack Weak<T> {
        var _raw: T*
    }

    @Experimental(sinceAzora: "0.0.3")
    oper.* [self: Weak<T>&]: T {
        assert self._raw != null { "Weak pointer is null" }
        return self._raw.*
    }

    impl Weak<T> {
        /** Returns the referenced value (panics if the pointer is null). */
        @Experimental(sinceAzora: "0.0.3")
        prop get[self: Self&]: T {
            assert self._raw != null { "Weak pointer is null" }
            return self._raw.*
        }

        /** Returns the raw `T*` (may be null). */
        @SinceAzora("0.0.3")
        prop ptr[self: Self&]: T* = self._raw

        /** `true` when the pointer is null (does not own a reference). */
        @SinceAzora("0.0.3")
        prop isNull[self: Self&]: Bool = self._raw == null
    }

    /** Wraps a raw `T*` as a non-owning `Weak<T>`. */
    @Experimental(sinceAzora: "0.0.3")
    func weakOf<T>(ptr: T*): Weak<T> {
        return Weak(ptr)
    }
}
