module std.memory.syncshared

/**
 * @file std/memory/syncshared
 *
 * A shared pointer whose reference count is safe to touch from several threads
 * (`SyncShared<T>`).
 *
 * One heap allocation, many owners: `retain()` records a new owner, `release()`
 * gives one up and reclaims the allocation when the last one leaves. The count
 * is synchronised, which is the whole difference from [Shared] - reach for that
 * one when the owners all live on a single thread and you would rather not pay
 * for the synchronisation.
 *
 * @since 0.1
 */

realm std {
    /**
     * A reference-counted pointer to a `T`, countable across threads.
     *
     * @generic T the pointee type.
     */
    @Since("0.1")
    pack SyncShared<T> {
        var raw: T*
        var count: Int
    }

    @Experimental(since: "0.1")
    oper.* [self: SyncShared<T>&]: T {
        return self.raw.*
    }

    /**
     * Cloning a `SyncShared` produces another owner of the *same* value - it does
     * not duplicate the pointee. It is never `Copy`: a new owner is a change to
     * the reference count, and the model keeps that visible at the call site.
     *
     * The count is adjusted by `retain`/`release`, which take an exclusive
     * receiver; `clone` borrows shared, so a caller that keeps the clone past
     * the original's lifetime pairs it with a `retain`.
     */
    @Since("0.1")
    impl Clone for SyncShared<T> {
        func clone[self: Self&]() {
            return SyncShared<T>(self.raw, self.count)
        }
    }

    impl SyncShared<T> {
        /** The pointed-to value. */
        @Since("0.1")
        prop get[self: Self&]: T = self.raw.*

        /** Replaces the pointed-to value without changing ownership. */
        @Experimental(since: "0.1")
        func set(value: T) { self.raw[0] = value }

        /** Records a new shared owner. Returns the new reference count. */
        @Experimental(since: "0.1")
        func retain(): Int {
            self.count = self.count + 1
            return self.count
        }

        /** Drops a shared owner; reclaims the allocation when the count reaches zero. */
        @Experimental(since: "0.1")
        func release(): Int {
            self.count = self.count - 1
            if self.count <= 0 {
                purge self.raw
            }
            return self.count
        }

        /** The current number of live references. */
        @Since("0.1")
        prop refCount[self: Self&]: Int = self.count

        /** The underlying `T*` (escapes the counting). */
        @Since("0.1")
        prop ptr[self: Self&]: T* = self.raw
    }

    @Experimental(since: "0.1")
    func syncSharedOf<T>(value: T): SyncShared<T> {
        return SyncShared(alloc value, 1)
    }
}
