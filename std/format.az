/**
 * @file std/format.az
 *
 * Rendering a value as text.
 *
 * A type says how it prints by implementing [Display], whose single member is
 * handed a [Formatter] to write into rather than asked to return a `String`.
 * Writing into a buffer is what lets a composite render its parts without each
 * one allocating: a list of a thousand points appends to one buffer instead of
 * building a thousand intermediate strings.
 *
 * `"${value}"` calls [Display] and nothing else, so a type that has not said
 * how it prints does not print - the interpolation is a compile error naming
 * the missing implementation rather than a fallback that leaks a pack's
 * internals into output.
 *
 * @since 0.1
 */
@Supress(.Unused)
module std.format

/**
 * The text buffer a [Display] writes into.
 *
 * Every `write` appends; nothing here can rewind or inspect what has been
 * written, so a nested `display` cannot corrupt its caller's output.
 */
@Since("0.1")
pack Formatter {
    var buffer: String = ""
}

@Since("0.1")
impl Formatter {
    /** Appends [text] as it stands. */
    func !.write(text: String) {
        self.buffer = self.buffer + text
    }

    /** Appends [text] followed by a newline. */
    func !.writeLine(text: String) {
        self.buffer = self.buffer + text + "\n"
    }

    /** Everything written so far. */
    prop &.rendered: String {
        return self.buffer
    }
}

/**
 * A type with a canonical text form.
 *
 * `bridge` so that the primitives can conform without writing a body - the
 * backends already render an `Int` - while any other type states how it
 * prints and gets `"${value}"` for it.
 */
@Since("0.1")
bridge spec Display {
    func &.display(formatter: Formatter!)
}

/**
 * Renders [value] through its [Display] implementation.
 *
 * The one-shot form, for when a `String` really is what is wanted; a
 * composite should take the caller's [Formatter] instead of calling this
 * per part.
 */
@Since("0.1")
func<T> format(value: T&): String {
    var formatter = Formatter()
    value.display(formatter)
    return formatter.rendered
}
