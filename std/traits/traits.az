module std.traits

expose import std.traits.core
import std.convert

/**
 * @file std/traits/traits
 *
 * Core type traits and promotion system.
 *
 * Defines the Numeric spec for arithmetic types and the
 * compile-time type promotion function for mixed-type expressions.
 *
 * @since 0.0.1
 */

realm std {
    /**
     * A specification that marks types supporting arithmetic operations.
     *
     * Types implementing Numeric can be used with standard math operators
     * and the Promote type property.
     */
    @Since("0.0.1")
    spec Numeric

    /** Int satisfies the Numeric spec. */
    @Since("0.0.1")
    impl Numeric for Int

    /** Double satisfies the Numeric spec. */
    @Since("0.0.1")
    impl Numeric for Double

    /**
     * Chooses the type with the highest primitive promotion rank.
     *
     * Promotion is evaluated entirely at compile time. Exact user-defined
     * `deepinline prop Promote<...>` overloads may specialize pairs, while this
     * variadic overload provides the standard result for two or more primitive
     * types.
     *
     * @generic T Two or more primitive types to compare.
     * @return The widest type in T according to Type.rank.
     */
    @Since("0.0.5")
    deepinline prop Promote<...T>: Type where T.length >= 2 && T is Number {
        var result: Type = T.0
        for candidate: Type in T[1...] {
            if candidate::rank > result::rank {
                result = candidate
            }
        }
        return result
    }

    /** Types that can be copied. */
    @Since("0.0.1")
    spec Copyable

    /** Int is copyable. */
    @Since("0.0.1")
    impl Copyable for Int

    /** Double is copyable. */
    @Since("0.0.1")
    impl Copyable for Double

    /** String is copyable. */
    @Since("0.0.1")
    impl Copyable for String

    /** Char is copyable. */
    @Since("0.0.1")
    impl Copyable for Char

    /** Bool is copyable. */
    @Since("0.0.1")
    impl Copyable for Bool

    /** Types that support deep copying. */
    @Since("0.0.1")
    spec Cloneable

    /** Int is cloneable. */
    @Since("0.0.1")
    impl Cloneable for Int

    /** Double is cloneable. */
    @Since("0.0.1")
    impl Cloneable for Double

    /** String is cloneable. */
    @Since("0.0.1")
    impl Cloneable for String

    /** Char is cloneable. */
    @Since("0.0.1")
    impl Cloneable for Char

    /** Bool is cloneable. */
    @Since("0.0.1")
    impl Cloneable for Bool

    /**
     * Types that can be iterated over.
     */
    @Since("0.0.1")
    spec Iterable

    /**
     * An iterator that produces values one at a time.
     */
    @Since("0.0.1")
    spec Iterator

    @Since("0.0.4")
    spec PrettyPrint {
        prop pretty[self: Self&]: String
    }
}
