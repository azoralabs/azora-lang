@Supress(.Unused)
module std.container.queue

import std.serializer::Serializable

/**
 * A generic first-in-first-out (FIFO) queue.
 *
 * Queue provides pointer-backed storage where elements are
 * added at the back and removed from the front.
 *
 * @generic T The type of elements stored in this queue.
 */
@Since("0.1")
@Serializable
pack Queue<T> {
    var data: T* = alloc .() * 8
    var size: Int = 0
    var capacity: Int = 8
}

/** Queue operations: enqueue, dequeue, peek, clear, and string conversion. */
impl Queue<T> {
    // --- Properties ---

    /** Whether the queue contains no elements. */
    @Since("0.1")
    prop &.isEmpty: Bool = self.size == 0

    /** Whether the queue contains at least one element. */
    @Since("0.1")
    prop &.isNotEmpty: Bool = self.size > 0

    // --- Internal ---

    /** Doubles the backing buffer's capacity, copying existing elements. */
    @Experimental(since: "0.1")
    func !.growQueue() {
        fin newCap = self.capacity * 2
        let newData: T* = alloc .() * newCap
        for i in 0..<self.size {
            newData[i] = self.data[i]
        }
        fin oldData = self.data
        self.data = newData
        self.capacity = newCap
        purge oldData
    }

    // --- Operations ---

    /**
     * Adds an element to the back of the queue.
     *
     * @param element The element to enqueue.
     */
    @Experimental(since: "0.1")
    func !.enqueue(element: T) {
        if self.size >= self.capacity {
            self.growQueue()
        }
        self.data[self.size] = element
        self.size++
    }

    /**
     * Removes and returns the front element of the queue.
     *
     * @return The removed front element.
     * @throws AssertionError if the queue is empty.
     */
    @Experimental(since: "0.1")
    func &.dequeue(): T
    in {
        assert self.size > 0 panic "Queue is empty"
    } scope {
        fin front = self.data[0]
        for i: Int in 0..<self.size - 1 then self.data[i] = self.data[i + 1]
        self.size--
        return front
    }

    /**
     * Returns the front element without removing it.
     *
     * @return The front element.
     * @throws AssertionError if the queue is empty.
     */
    @Experimental(since: "0.1")
    func &.peek(): T {
        return self.data[0]
    }

    /** Removes all elements from the queue. */
    @Experimental(since: "0.1")
    func !.clear() {
        fin oldData = self.data
        self.{data, size, capacity} = {alloc .() * 8, 0, 8}
        purge oldData
    }

    // --- String ---

    /**
     * Returns a string representation of the queue.
     *
     * @return A string in the format "[front, ..., back]".
     */
    @Experimental(since: "0.1")
    func &.toString(): String {
        var s = "["
        for i in 0..<self.size {
            if i > 0 {
                s += ", "
            }
            s += self.data[i] as String
        }
        return s + "]"
    }
}

test "queue starts empty" {
    fin value: Queue<Int> = .()
    assert value.size == 0 && value.isEmpty panic "new queue must be empty"
}

test "queue is FIFO" {
    var value: Queue<Int> = .()
    value.enqueue({1, 2, 3})
    assert value.peek() == 1 panic "queue peek must return the oldest value"
    assert value.dequeue() == 1 && value.dequeue() == 2 && value.dequeue() == 3 panic "queue order must be FIFO"
    assert value.isEmpty panic "queue must be empty after all dequeues"
}

test "queue grows without losing order" {
    var value: Queue<Int> = .()
    for i: Int = 0..<20 then value.enqueue(i)
    for i: Int = 0..<20 then assert value.dequeue() == i panic "queue growth reordered an element"
}

test "queue clear permits reuse" {
    var value: Queue<Int> = .()
    value.{enqueue({1, 2}), clear(), enqueue(8)}
    assert value.size == 1 && value.dequeue() == 8 panic "cleared queue must be reusable"
}

test "queue serialization metadata is declared" {
    import std.{reflection::reflect, serializer::Serializable}
    inline assert reflect<Queue>.hasAnnot<Serializable> panic "Queue must carry Serializable metadata"
}

test .All "queue"
