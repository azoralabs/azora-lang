@Supress(.Unused)
exposed module std.config

deepinline scope {
    @Since("0.1")
    enum CompilerTarget {
        Interpret
        Native
        WebAssembly
    }

    /**
     * Overriden by compiler flag -Target=Native
     */
    @Since("0.1")
    fin target: CompilerTarget = .Interpret

    /**
     * Overriden by compiler flag --debug and --release
     */
    @Since("0.1")
    fin debug: Bool = true

    /**
     * Overriden by compiler flag --debug and --release
     */
    @Since("0.1")
    fin release: Bool = !DEBUG

    /**
     * Overriden by compiler flag --test
     */
    @Since("0.1")
    fin testMode: Bool = false
}
