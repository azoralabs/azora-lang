module std.container.map

import std.container.array

import std.container.list

/**
 * @file std/container/map
 *
 * Proposed native map hierarchy for Azora.
 *
 * Maps use operators supplied by their key and value types. There are no
 * runtime hasher, equality, or comparator objects:
 *
 * - `HashMap<K, V>` and `LinkedHashMap<K, V>` require `oper#` and `oper==`
 *   for `K`.
 * - `TreeMap<K, V>` requires `oper<` for `K`.
 * - `containsValue`, structural `oper==`, and structural `oper#` instantiate
 *   only when the corresponding value operators exist.
 *
 * `oper[start:stop:step]` returns a snapshot of the map's entries using its
 * iteration order. `start` is inclusive, `stop` is exclusive, and `step`
 * defaults to `1`. Omitting `start` begins from the first entry, omitting
 * `stop` continues to the last entry, and negative indices count backward from
 * the end. The result is always a `LinkedHashMap` snapshot, preserving the
 * observed iteration order even when the source is a `HashMap`. Key ranges on
 * sorted maps use `subMap`, `headMap`, and `tailMap`; this avoids ambiguity
 * when `K` is an integer type.
 *
 * @since 0.0.4
 */

realm std {
    /**
     * One immutable key-value association.
     *
     * @generic K The key type.
     * @generic V The value type.
     */
    @Experimental(since: "0.0.4")
    pack MapEntry<K, V> {
        fin key: K
        fin value: V
    }

    /**
     * Read-only behavior shared by every map implementation.
     *
     * `Map` does not promise a particular iteration order. A concrete pack may
     * provide a stronger guarantee. Index access returns `null` for an absent
     * key, matching Kotlin map access.
     *
     * @generic K The key type.
     * @generic V The value type.
     */
    @Experimental(since: "0.0.4")
    spec Map<K, V> {
        /** Number of unique keys. */
        prop size[self: Self&]: Int

        /** Whether this map has no entries. */
        prop isEmpty[self: Self&]: Bool

        /** Whether this map has at least one entry. */
        prop isNotEmpty[self: Self&]: Bool

        /** Returns whether `key` is present. */
        func containsKey[self: Self&](key: K&): Bool

        /** Returns whether an equal value is present. Requires `oper==` for `V`. */
        func containsValue[self: Self&](value: V&): Bool

        /** Returns the value associated with `key`, or `null` when absent. */
        func get[self: Self&](key: K&): V?

        /** Returns the associated value, or `defaultValue` when absent. */
        func getOrDefault[self: Self&](key: K&, defaultValue: V): V

        /** Returns an iteration-order snapshot of all entries. */
        func entries[self: Self&](): Array<MapEntry<K, V>>

        /** Returns an iteration-order snapshot of all keys. */
        func keys[self: Self&](): List<K>

        /** Returns an iteration-order snapshot of all values. */
        func values[self: Self&](): List<V>

        /** Invokes `action` once for every entry in iteration order. */
        func forEach[self: Self&](action: (K&, V&) -> Unit)
    }

    /**
     * A Map is cloned by duplicating its elements; it is never `Copy`,
     * because duplicating a collection implicitly would hide an allocation.
     */
    @Since("0.0.5")
    impl Clone for Map

    /**
     * Mutation behavior implemented by mutable map packs.
     *
     * Mutation always receives `self!`. Implementing this spec does not
     * weaken a `ref Map<K, V>` view: callers holding only a shared reference can
     * still use only read operations.
     *
     * @generic K The key type.
     * @generic V The value type.
     */
    @Experimental(since: "0.0.4")
    spec MutableMap<K, V> : Map<K, V> {
        /** Associates `key` with `value` and returns the replaced value, if any. */
        func put[self: Self&](key: K, value: V): V?

        /** Copies all entries from `other`, replacing equal keys. */
        func putAll[self: Self&](other: Map<K, V>&)

        /** Removes `key` and returns its previous value, or `null` when absent. */
        func remove[self: Self&](key: K&): V?

        /** Removes every entry while retaining reusable internal capacity. */
        func clear[self: Self&]()

        /** Returns the existing value or inserts and returns `defaultValue()`. */
        func getOrPut[self: Self&](key: K, defaultValue: () -> V): V
    }

    /**
     * Ordered navigation supplied by maps whose keys obey `oper<`.
     *
     * Iteration is ascending according to the strict weak ordering defined by
     * `oper<`. Keys `a` and `b` are equivalent when neither `a < b` nor `b < a`.
     * `TreeMap` therefore does not require `oper==` for keys.
     *
     * @generic K The ordered key type.
     * @generic V The value type.
     */
    @Experimental(since: "0.0.4")
    spec SortedMap<K, V> {
        /** Returns the smallest key, or `null` when empty. */
        func firstKey[self: Self&](): K?

        /** Returns the greatest key, or `null` when empty. */
        func lastKey[self: Self&](): K?

        /** Returns the greatest key strictly below `key`. */
        func lowerKey[self: Self&](key: K&): K?

        /** Returns the greatest key below or equivalent to `key`. */
        func floorKey[self: Self&](key: K&): K?

        /** Returns the smallest key equivalent to or above `key`. */
        func ceilingKey[self: Self&](key: K&): K?

        /** Returns the smallest key strictly above `key`. */
        func higherKey[self: Self&](key: K&): K?

        /** Returns the entry with the smallest key, or `null` when empty. */
        func firstEntry[self: Self&](): MapEntry<K, V>?

        /** Returns the entry with the greatest key, or `null` when empty. */
        func lastEntry[self: Self&](): MapEntry<K, V>?

        /** Returns an ascending read-only view below `toKey`. */
        func headMap[self: Self&](toKey: K&, inclusive: Bool = false): SortedMap<K, V>

        /** Returns an ascending read-only view above `fromKey`. */
        func tailMap[self: Self&](fromKey: K&, inclusive: Bool = true): SortedMap<K, V>

        /** Returns an ascending read-only view between two key boundaries. */
        func subMap[self: Self&](
            fromKey: K&,
            fromInclusive: Bool,
            toKey: K&,
            toInclusive: Bool
        ): SortedMap<K, V>
    }

    /**
     * Mutable operations specific to an ordered map.
     *
     * Polling removes and returns a boundary entry in one tree operation.
     */
    @Experimental(since: "0.0.4")
    spec MutableSortedMap<K, V> : SortedMap<K, V> {
        /** Removes and returns the smallest entry, or `null` when empty. */
        func pollFirstEntry[self: Self&](): MapEntry<K, V>?

        /** Removes and returns the greatest entry, or `null` when empty. */
        func pollLastEntry[self: Self&](): MapEntry<K, V>?
    }

    /** Hash table with unspecified iteration order. `K` requires `oper#` and `oper==`. */
    @Experimental(since: "0.0.4")
    pack HashMap<K, V> {
        var keys: K* = alloc K[16]
        var values: V* = alloc V[16]
        var hashes: ULong* = alloc ULong[16]
        var occupied: Bool* = alloc Bool[16]
        var __size: Int = 0
        var capacity: Int = 16
    }

    /** Hash table whose dense entry storage preserves insertion order. */
    @Experimental(since: "0.0.4")
    pack LinkedHashMap<K, V> {
        var keys: K* = alloc K[16]
        var values: V* = alloc V[16]
        var hashes: ULong* = alloc ULong[16]
        var buckets: Int* = alloc Int[32]
        var __size: Int = 0
        var capacity: Int = 16
        var bucketCapacity: Int = 32
    }

    /** AVL tree map ordered exclusively through `oper<` for `K`. */
    @Experimental(since: "0.0.4")
    pack TreeMap<K, V> {
        var keys: K* = alloc K[16]
        var values: V* = alloc V[16]
        var left: Int* = alloc Int[16]
        var right: Int* = alloc Int[16]
        var parent: Int* = alloc Int[16]
        var heights: Int* = alloc Int[16]
        var freeNext: Int* = alloc Int[16]
        var root: Int = -1
        var freeHead: Int = -1
        var elemCount: Int = 0
        var __size: Int = 0
        var capacity: Int = 16
    }

    /** Normalized operands delivered to `oper[:]` for slicing. */
    @Experimental(since: "0.0.4")
    pack MapSlice {
        fin start: Int
        fin end: Int
        fin step: Int = 1
    }

    // ---------------------------------------------------------------------
    // HashMap implementation
    // ---------------------------------------------------------------------

    impl ctor() for HashMap<K, V> { self! ->
        for i in 0..<self.capacity {
            self.occupied[i] = false
        }
    }

    impl dtor() for HashMap<K, V> {
        self& ->
        purge self.keys
        purge self.values
        purge self.hashes
        purge self.occupied
    }

    /**
     * A HashMap owns its backing buffers: it moves and clones, never copies
     * implicitly.
     */

    @Since("0.0.5")
    impl Clone for HashMap {
        func clone[self: Self&]() {
            var copy = HashMap<K, V>()
            for i in 0..<self.capacity {
                if self.occupied[i] {
                    copy.put(self.keys[i], self.values[i])
                }
            }
            return copy
        }
    }

    impl HashMap<K, V> {
        func _bucketFor[self: Self&](hash: ULong): Int {
            return (hash % (self.capacity as ULong)) as Int
        }

        func _findIndex[self: Self&](key: K&): Int {
            fin hash = #key
            var index = self._bucketFor(hash)
            for visited in 0..<self.capacity {
                if !self.occupied[index] { return -1 }
                if self.hashes[index] == hash && self.keys[index] == key { return index }
                index = (index + 1) % self.capacity
            }
            return -1
        }

        func _insertKnownHash[self: Self!](key: K, value: V, hash: ULong): V? {
            var index = self._bucketFor(hash)
            while self.occupied[index] {
                if self.hashes[index] == hash && self.keys[index] == key {
                    fin previous = self.values[index]
                    self.values[index] = value
                    return previous
                }
                index = (index + 1) % self.capacity
            }
            self.keys[index] = key
            self.values[index] = value
            self.hashes[index] = hash
            self.occupied[index] = true
            self.__size += 1
            return null
        }

        func _rehash[self: Self!](newCapacity: Int) {
            fin oldKeys = self.keys
            fin oldValues = self.values
            fin oldHashes = self.hashes
            fin oldOccupied = self.occupied
            fin oldCapacity = self.capacity

            self.keys = alloc K[newCapacity]
            self.values = alloc V[newCapacity]
            self.hashes = alloc ULong[newCapacity]
            self.occupied = alloc Bool[newCapacity]
            self.capacity = newCapacity
            self.__size = 0

            var i = 0
            while i < newCapacity {
                self.occupied[i] = false
                i += 1
            }
            i = 0
            while i < oldCapacity {
                if oldOccupied[i] {
                    self._insertKnownHash(oldKeys[i], oldValues[i], oldHashes[i])
                }
                i += 1
            }
            purge oldKeys
            purge oldValues
            purge oldHashes
            purge oldOccupied
        }

        func _ensureInsertCapacity[self: Self!]() {
            if (self.__size + 1) * 10 >= self.capacity * 7 {
                self._rehash(self.capacity * 2)
            }
        }

        func _putValue[self: Self!](key: K, value: V): V? {
            self._ensureInsertCapacity()
            fin hash = #key
            return self._insertKnownHash(key, value, hash)
        }

        func _removeValue[self: Self!](key: K&): V? {
            fin found = self._findIndex(key)
            if found < 0 { return null }
            fin previous = self.values[found]
            self.occupied[found] = false
            self.__size -= 1

            var index = (found + 1) % self.capacity
            while self.occupied[index] {
                fin movedKey = self.keys[index]
                fin movedValue = self.values[index]
                fin movedHash = self.hashes[index]
                self.occupied[index] = false
                self.__size -= 1
                self._insertKnownHash(movedKey, movedValue, movedHash)
                index = (index + 1) % self.capacity
            }
            return previous
        }

        func _entrySnapshot[self: Self&](): Array<MapEntry<K, V>> {
            var result: Array<MapEntry<K, V>> = Array::fill<MapEntry<K, V>>(self.__size)
            var source = 0
            var target = 0
            while source < self.capacity {
                if self.occupied[source] {
                    result[target] = MapEntry(self.keys[source], self.values[source])
                    target += 1
                }
                source += 1
            }
            return result
        }
    }

    impl Map<K, V> for HashMap<K, V> {
        prop size[self: Self&]: Int = self.__size
        prop isEmpty[self: Self&]: Bool = self.__size == 0
        prop isNotEmpty[self: Self&]: Bool = self.__size > 0

        func containsKey[self: Self&](key: K&): Bool { return self._findIndex(key) >= 0 }

        func containsValue[self: Self&](value: V&): Bool {
            for i in 0..<self.capacity {
                if self.occupied[i] && self.values[i] == value { return true }
            }
            return false
        }

        func get[self: Self&](key: K&): V? {
            fin index = self._findIndex(key)
            if index < 0 { return null }
            return self.values[index]
        }

        func getOrDefault[self: Self&](key: K&, defaultValue: V): V {
            fin index = self._findIndex(key)
            if index < 0 { return defaultValue }
            return self.values[index]
        }

        func entries[self: Self&](): Array<MapEntry<K, V>> { return self._entrySnapshot() }

        func keys[self: Self&](): List<K> {
            fin all = self.entries()
            var result: Array<K> = Array::fill<K>(all.size)
            for i in 0..<all.size {
                result[i] = all[i].key
            }
            return result
        }

        func values[self: Self&](): List<V> {
            fin all = self._entrySnapshot()
            var result: Array<V> = Array::fill<V>(all.size)
            for i in 0..<all.size {
                result[i] = all[i].value
            }
            return result
        }

        func forEach[self: Self&](action: (K&, V&) -> Unit) {
            for i in 0..<self.capacity {
                if self.occupied[i] {
                    action(self.keys[i], self.values[i])
                }
            }
        }
    }

    impl MutableMap<K, V> for HashMap<K, V> {
        func put[self: Self!](key: K, value: V): V? {
            return self._putValue(key, value)
        }

        func putAll[self: Self!](other: Map<K, V>&) {
            fin all = other.entries()
            for i in 0..<all.size {
                self._putValue(all[i].key, all[i].value)
            }
        }

        func remove[self: Self!](key: K&): V? {
            return self._removeValue(key)
        }

        func clear[self: Self!]() {
            for i in 0..<self.capacity {
                self.occupied[i] = false
            }
            self.__size = 0
        }

        func getOrPut[self: Self!](key: K, defaultValue: () -> V): V {
            fin index = self._findIndex(key)
            if index >= 0 { return self.values[index] }
            fin value = defaultValue()
            self._putValue(key, value)
            return value
        }
    }

    // ---------------------------------------------------------------------
    // LinkedHashMap implementation
    // ---------------------------------------------------------------------

    impl ctor() for LinkedHashMap<K, V> { self! ->
        for i in 0..<self.bucketCapacity {
            self.buckets[i] = -1
        }
    }

    impl dtor() for LinkedHashMap<K, V> { self& ->
        purge self.keys
        purge self.values
        purge self.hashes
        purge self.buckets
    }

    impl LinkedHashMap<K, V> {
        func _findIndex[self: Self&](key: K&): Int {
            fin hash = #key
            var bucket = (hash % (self.bucketCapacity as ULong)) as Int
            for visited in 0..<self.bucketCapacity {
                fin index = self.buckets[bucket]
                if index < 0 { return -1 }
                if self.hashes[index] == hash && self.keys[index] == key { return index }
                bucket = (bucket + 1) % self.bucketCapacity
            }
            return -1
        }

        func _insertBucket[self: Self!](index: Int) {
            var bucket = (self.hashes[index] % (self.bucketCapacity as ULong)) as Int
            while self.buckets[bucket] >= 0 {
                bucket = (bucket + 1) % self.bucketCapacity
            }
            self.buckets[bucket] = index
        }

        func _rebuildBuckets[self: Self!](newCapacity: Int) {
            fin oldBuckets = self.buckets
            self.buckets = alloc Int[newCapacity]
            self.bucketCapacity = newCapacity
            var i = 0
            while i < newCapacity {
                self.buckets[i] = -1
                i += 1
            }
            i = 0
            while i < self.__size {
                self._insertBucket(i)
                i += 1
            }
            purge oldBuckets
        }

        func _growEntries[self: Self!]() {
            fin newCapacity = self.capacity * 2
            let newKeys = alloc K[newCapacity]
            let newValues = alloc V[newCapacity]
            let newHashes = alloc ULong[newCapacity]
            for i in 0..<self.__size {
                newKeys[i] = self.keys[i]
                newValues[i] = self.values[i]
                newHashes[i] = self.hashes[i]
            }
            fin oldKeys = self.keys
            fin oldValues = self.values
            fin oldHashes = self.hashes
            self.keys = newKeys
            self.values = newValues
            self.hashes = newHashes
            self.capacity = newCapacity
            purge oldKeys
            purge oldValues
            purge oldHashes
        }

        func _putValue[self: Self!](key: K, value: V): V? {
            fin found = self._findIndex(key)
            if found >= 0 {
                fin previous = self.values[found]
                self.values[found] = value
                return previous
            }
            if self.__size >= self.capacity {
                self._growEntries()
            }
            if (self.__size + 1) * 10 >= self.bucketCapacity * 7 {
                self._rebuildBuckets(self.bucketCapacity * 2)
            }
            fin hash = #key
            self.keys[self.__size] = key
            self.values[self.__size] = value
            self.hashes[self.__size] = hash
            self._insertBucket(self.__size)
            self.__size += 1
            return null
        }

        func _removeValue[self: Self!](key: K&): V? {
            fin found = self._findIndex(key)
            if found < 0 { return null }
            fin previous = self.values[found]
            for i in found..<self.__size - 1 {
                self.keys[i] = self.keys[i + 1]
                self.values[i] = self.values[i + 1]
                self.hashes[i] = self.hashes[i + 1]
            }
            self.__size -= 1
            self._rebuildBuckets(self.bucketCapacity)
            return previous
        }

        func _entrySnapshot[self: Self&](): Array<MapEntry<K, V>> {
            var result: Array<MapEntry<K, V>> = Array::fill<MapEntry<K, V>>(self.__size)
            for i in 0..<self.__size {
                result[i] = MapEntry(self.keys[i], self.values[i])
            }
            return result
        }
    }

    impl Map<K, V> for LinkedHashMap<K, V> {
        prop size[self: Self&]: Int = self.__size
        prop isEmpty[self: Self&]: Bool = self.__size == 0
        prop isNotEmpty[self: Self&]: Bool = self.__size > 0

        func containsKey[self: Self&](key: K&): Bool {
            return self._findIndex(key) >= 0
        }

        func containsValue[self: Self&](value: V&): Bool {
            for i in 0..<self.__size {
                if self.values[i] == value { return true }
            }
            return false
        }

        func get[self: Self&](key: K&): V? {
            fin index = self._findIndex(key)
            if index < 0 { return null }
            return self.values[index]
        }

        func getOrDefault[self: Self&](key: K&, defaultValue: V): V {
            fin index = self._findIndex(key)
            if index < 0 { return defaultValue }
            return self.values[index]
        }

        func entries[self: Self&](): Array<MapEntry<K, V>> {
            return self._entrySnapshot()
        }

        func keys[self: Self&](): List<K> {
            var result: Array<K> = Array::fill<K>(self.__size)
            for i in 0..<self.__size {
                result[i] = self.keys[i]
            }
            return result
        }

        func values[self: Self&](): List<V> {
            var result: Array<V> = Array::fill<V>(self.__size)
            for i in 0..<self.__size {
                result[i] = self.values[i]
            }
            return result
        }

        func forEach[self: Self&](action: (K&, V&) -> Unit) {
            for i in 0..<self.__size {
                action(self.keys[i], self.values[i])
            }
        }
    }

    impl MutableMap<K, V> for LinkedHashMap<K, V> {
        func put[self: Self!](key: K, value: V): V? {
            return self._putValue(key, value)
        }

        func putAll[self: Self!](other: Map<K, V>&) {
            fin all = other.entries()
            for i in 0..<all.size {
                self._putValue(all[i].key, all[i].value)
            }
        }

        func remove[self: Self!](key: K&): V? {
            return self._removeValue(key)
        }

        func clear[self: Self!]() {
            self.__size = 0
            for i in 0..<self.bucketCapacity {
                self.buckets[i] = -1
            }
        }

        func getOrPut[self: Self!](key: K, defaultValue: () -> V): V {
            fin index = self._findIndex(key)
            if index >= 0 { return self.values[index] }
            fin value = defaultValue()
            self._putValue(key, value)
            return value
        }
    }

    // ---------------------------------------------------------------------
    // TreeMap implementation (AVL balanced tree)
    // ---------------------------------------------------------------------

    impl dtor() for TreeMap<K, V> { self& ->
        purge self.keys
        purge self.values
        purge self.left
        purge self.right
        purge self.parent
        purge self.heights
        purge self.freeNext
    }

    impl TreeMap<K, V> {
        func _elemHeight[self: Self&](elem: Int): Int {
            if elem < 0 { return 0 }
            return self.heights[elem]
        }

        func _updateHeight[self: Self!](elem: Int) {
            if elem < 0 { return }
            fin leftHeight = self._elemHeight(self.left[elem])
            fin rightHeight = self._elemHeight(self.right[elem])
            self.heights[elem] = if leftHeight > rightHeight {
                leftHeight + 1
            } else {
                rightHeight + 1
            }
        }

        func _grow[self: Self!]() {
            fin newCapacity = self.capacity * 2
            let newKeys = alloc K[newCapacity]
            let newValues = alloc V[newCapacity]
            let newLeft = alloc Int[newCapacity]
            let newRight = alloc Int[newCapacity]
            let newParent = alloc Int[newCapacity]
            let newHeights = alloc Int[newCapacity]
            let newFreeNext = alloc Int[newCapacity]
            for i in 0..<self.elemCount {
                newKeys[i] = self.keys[i]
                newValues[i] = self.values[i]
                newLeft[i] = self.left[i]
                newRight[i] = self.right[i]
                newParent[i] = self.parent[i]
                newHeights[i] = self.heights[i]
                newFreeNext[i] = self.freeNext[i]
            }
            purge self.keys
            purge self.values
            purge self.left
            purge self.right
            purge self.parent
            purge self.heights
            purge self.freeNext
            self.keys = newKeys
            self.values = newValues
            self.left = newLeft
            self.right = newRight
            self.parent = newParent
            self.heights = newHeights
            self.freeNext = newFreeNext
            self.capacity = newCapacity
        }

        func _allocateNode[self: Self!](key: K, value: V, parent: Int): Int {
            var elem = self.freeHead
            if elem >= 0 {
                self.freeHead = self.freeNext[elem]
            } else {
                if self.elemCount >= self.capacity {
                    self._grow()
                }
                elem = self.elemCount
                self.elemCount += 1
            }
            self.keys[elem] = key
            self.values[elem] = value
            self.left[elem] = -1
            self.right[elem] = -1
            self.parent[elem] = parent
            self.heights[elem] = 1
            self.__size += 1
            return elem
        }

        func _releaseNode[self: Self!](elem: Int) {
            self.freeNext[elem] = self.freeHead
            self.freeHead = elem
            self.__size -= 1
        }

        func _replaceParentChild[self: Self!](parent: Int, oldChild: Int, newChild: Int) {
            if parent < 0 {
                self.root = newChild
            } else if self.left[parent] == oldChild {
                self.left[parent] = newChild
            } else {
                self.right[parent] = newChild
            }
            if newChild >= 0 { self.parent[newChild] = parent }
        }

        func _rotateLeft[self: Self!](elem: Int): Int {
            fin pivot = self.right[elem]
            fin oldParent = self.parent[elem]
            self.right[elem] = self.left[pivot]
            if self.right[elem] >= 0 {
                self.parent[self.right[elem]] = elem
            }
            self.left[pivot] = elem
            self.parent[elem] = pivot
            self.parent[pivot] = oldParent
            self._replaceParentChild(oldParent, elem, pivot)
            self._updateHeight(elem)
            self._updateHeight(pivot)
            return pivot
        }

        func _rotateRight[self: Self!](elem: Int): Int {
            fin pivot = self.left[elem]
            fin oldParent = self.parent[elem]
            self.left[elem] = self.right[pivot]
            if self.left[elem] >= 0 {
                self.parent[self.left[elem]] = elem
            }
            self.right[pivot] = elem
            self.parent[elem] = pivot
            self.parent[pivot] = oldParent
            self._replaceParentChild(oldParent, elem, pivot)
            self._updateHeight(elem)
            self._updateHeight(pivot)
            return pivot
        }

        func _rebalanceFrom[self: Self!](start: Int) {
            var elem = start
            while elem >= 0 {
                self._updateHeight(elem)
                fin balance = self._elemHeight(self.left[elem]) - self._elemHeight(self.right[elem])
                if balance > 1 {
                    if self._elemHeight(self.left[self.left[elem]]) < self._elemHeight(self.right[self.left[elem]]) {
                        self._rotateLeft(self.left[elem])
                    }
                    fin top = self._rotateRight(elem)
                    elem = self.parent[top]
                } else if balance < -1 {
                    if self._elemHeight(self.right[self.right[elem]]) < self._elemHeight(self.left[self.right[elem]]) {
                        self._rotateRight(self.right[elem])
                    }
                    fin top = self._rotateLeft(elem)
                    elem = self.parent[top]
                } else {
                    elem = self.parent[elem]
                }
            }
        }

        func _findNode[self: Self&](key: K&): Int {
            var elem = self.root
            while elem >= 0 {
                if key < self.keys[elem] {
                    elem = self.left[elem]
                } else if self.keys[elem] < key {
                    elem = self.right[elem]
                } else {
                    return elem
                }
            }
            return -1
        }

        func _putValue[self: Self!](key: K, value: V): V? {
            if self.root < 0 {
                self.root = self._allocateNode(key, value, -1)
                return null
            }
            var elem = self.root
            var parent = -1
            while elem >= 0 {
                parent = elem
                if key < self.keys[elem] {
                    elem = self.left[elem]
                } else if self.keys[elem] < key {
                    elem = self.right[elem]
                } else {
                    fin previous = self.values[elem]
                    self.values[elem] = value
                    return previous
                }
            }
            fin inserted = self._allocateNode(key, value, parent)
            if key < self.keys[parent] {
                self.left[parent] = inserted
            } else {
                self.right[parent] = inserted
            }
            self._rebalanceFrom(parent)
            return null
        }

        func _minimumNode[self: Self&](start: Int): Int {
            var elem = start
            if elem < 0 { return -1 }
            while self.left[elem] >= 0 {
                elem = self.left[elem]
            }
            return elem
        }

        func _maximumNode[self: Self&](start: Int): Int {
            var elem = start
            if elem < 0 { return -1 }
            while self.right[elem] >= 0 {
                elem = self.right[elem]
            }
            return elem
        }

        func _removeValue[self: Self!](key: K&): V? {
            var elem = self._findNode(key)
            if elem < 0 { return null }
            fin previous = self.values[elem]

            if self.left[elem] >= 0 && self.right[elem] >= 0 {
                fin successor = self._minimumNode(self.right[elem])
                self.keys[elem] = self.keys[successor]
                self.values[elem] = self.values[successor]
                elem = successor
            }

            fin child = if self.left[elem] >= 0 {
                self.left[elem]
            } else {
                self.right[elem]
            }
            fin oldParent = self.parent[elem]
            self._replaceParentChild(oldParent, elem, child)
            self._releaseNode(elem)
            self._rebalanceFrom(oldParent)
            return previous
        }

        func _entrySnapshot[self: Self&](): Array<MapEntry<K, V>> {
            var result: Array<MapEntry<K, V>> = Array::fill<MapEntry<K, V>>(self.__size)
            let stack = alloc Int[self.__size]
            var stackSize = 0
            var elem = self.root
            var output = 0
            while elem >= 0 || stackSize > 0 {
                while elem >= 0 {
                    stack[stackSize] = elem
                    stackSize += 1
                    elem = self.left[elem]
                }
                stackSize -= 1
                elem = stack[stackSize]
                result[output] = MapEntry(self.keys[elem], self.values[elem])
                output += 1
                elem = self.right[elem]
            }
            purge stack
            return result
        }
    }

    impl Map<K, V> for TreeMap<K, V> {
        prop size[self: Self&]: Int = self.__size
        prop isEmpty[self: Self&]: Bool = self.__size == 0
        prop isNotEmpty[self: Self&]: Bool = self.__size > 0

        func containsKey[self: Self&](key: K&): Bool {
            return self._findNode(key) >= 0
        }

        func containsValue[self: Self&](value: V&): Bool {
            fin all = self._entrySnapshot()
            for i in 0..<all.size {
                if all[i].value == value { return true }
            }
            return false
        }

        func get[self: Self&](key: K&): V? {
            fin elem = self._findNode(key)
            if elem < 0 { return null }
            return self.values[elem]
        }

        func getOrDefault[self: Self&](key: K&, defaultValue: V): V {
            fin elem = self._findNode(key)
            if elem < 0 { return defaultValue }
            return self.values[elem]
        }

        func entries[self: Self&](): Array<MapEntry<K, V>> { return self._entrySnapshot() }

        func keys[self: Self&](): List<K> {
            fin all = self.entries()
            var result: Array<K> = Array::fill<K>(all.size)
            for i in 0..<all.size {
                result[i] = all[i].key
            }
            return result
        }

        func values[self: Self&](): List<V> {
            fin all = self._entrySnapshot()
            var result: Array<V> = Array::fill<V>(all.size)
            for i in 0..<all.size {
                result[i] = all[i].value
            }
            return result
        }

        func forEach[self: Self&](action: (K&, V&) -> Unit) {
            fin all = self._entrySnapshot()
            for i in 0..<all.size {
                action(all[i].key, all[i].value)
            }
        }
    }

    impl MutableMap<K, V> for TreeMap<K, V> {
        func put[self: Self!](key: K, value: V): V? {
            return self._putValue(key, value)
        }

        func putAll[self: Self!](other: Map<K, V>&) {
            fin all = other.entries()
            for i in 0..<all.size {
                self._putValue(all[i].key, all[i].value)
            }
        }

        func remove[self: Self!](key: K&): V? { return self._removeValue(key) }

        func clear[self: Self!]() {
            self.root = -1
            self.freeHead = -1
            self.elemCount = 0
            self.__size = 0
        }

        func getOrPut[self: Self!](key: K, defaultValue: () -> V): V {
            fin elem = self._findNode(key)
            if elem >= 0 { return self.values[elem] }
            fin value = defaultValue()
            self._putValue(key, value)
            return value
        }
    }

    impl SortedMap<K, V> for TreeMap<K, V> {
        func firstKey[self: Self&](): K? {
            fin elem = self._minimumNode(self.root)
            if elem < 0 { return null }
            return self.keys[elem]
        }

        func lastKey[self: Self&](): K? {
            fin elem = self._maximumNode(self.root)
            if elem < 0 { return null }
            return self.keys[elem]
        }

        func lowerKey[self: Self&](key: K&): K? {
            var elem = self.root
            var candidate = -1
            while elem >= 0 {
                if self.keys[elem] < key {
                    candidate = elem
                    elem = self.right[elem]
                } else {
                    elem = self.left[elem]
                }
            }
            if candidate < 0 { return null }
            return self.keys[candidate]
        }

        func floorKey[self: Self&](key: K&): K? {
            fin exact = self._findNode(key)
            if exact >= 0 { return self.keys[exact] }
            return self.lowerKey(key)
        }

        func ceilingKey[self: Self&](key: K&): K? {
            fin exact = self._findNode(key)
            if exact >= 0 { return self.keys[exact] }
            return self.higherKey(key)
        }

        func higherKey[self: Self&](key: K&): K? {
            var elem = self.root
            var candidate = -1
            while elem >= 0 {
                if key < self.keys[elem] {
                    candidate = elem
                    elem = self.left[elem]
                }
                else {
                    elem = self.right[elem]
                }
            }
            if candidate < 0 { return null }
            return self.keys[candidate]
        }

        func firstEntry[self: Self&](): MapEntry<K, V>? {
            fin elem = self._minimumNode(self.root)
            if elem < 0 { return null }
            return MapEntry(self.keys[elem], self.values[elem])
        }

        func lastEntry[self: Self&](): MapEntry<K, V>? {
            fin elem = self._maximumNode(self.root)
            if elem < 0 { return null }
            return MapEntry(self.keys[elem], self.values[elem])
        }

        func headMap[self: Self&](toKey: K&, inclusive: Bool = false): SortedMap<K, V> {
            var result = TreeMap<K, V>()
            fin all = self._entrySnapshot()
            for i in 0..<all.size {
                fin beforeEnd = all[i].key < toKey || (inclusive && !(toKey < all[i].key))
                if beforeEnd { result.put(all[i].key, all[i].value) }
            }
            return result
        }

        func tailMap[self: Self&](fromKey: K&, inclusive: Bool = true): SortedMap<K, V> {
            var result = TreeMap<K, V>()
            fin all = self._entrySnapshot()
            for i in 0..<all.size {
                fin afterStart = fromKey < all[i].key || (inclusive && !(all[i].key < fromKey))
                if afterStart { result.put(all[i].key, all[i].value) }
            }
            return result
        }

        func subMap[self: Self&](fromKey: K&, fromInclusive: Bool, toKey: K&, toInclusive: Bool): SortedMap<K, V> {
            assert !(toKey < fromKey) { "subMap start must not be greater than end" }
            var result = TreeMap<K, V>()
            fin all = self._entrySnapshot()
            for i in 0..<all.size {
                fin afterStart = fromKey < all[i].key || (fromInclusive && !(all[i].key < fromKey))
                fin beforeEnd = all[i].key < toKey || (toInclusive && !(toKey < all[i].key))
                if afterStart && beforeEnd { result.put(all[i].key, all[i].value) }
            }
            return result
        }
    }

    impl MutableSortedMap<K, V> for TreeMap<K, V> {
        func pollFirstEntry[self: Self!](): MapEntry<K, V>? {
            fin elem = self._minimumNode(self.root)
            if elem < 0 { return null }
            fin result = MapEntry(self.keys[elem], self.values[elem])
            self._removeValue(self.keys[elem])
            return result
        }

        func pollLastEntry[self: Self!](): MapEntry<K, V>? {
            fin elem = self._maximumNode(self.root)
            if elem < 0 { return null }
            fin result = MapEntry(self.keys[elem], self.values[elem])
            self._removeValue(self.keys[elem])
            return result
        }
    }

    // ---------------------------------------------------------------------
    // Factories
    // ---------------------------------------------------------------------

    @Experimental(since: "0.0.4")
    func mapEntry<K, V>(key: K, value: V): MapEntry<K, V> {
        return MapEntry(key, value)
    }

    /**
     * Infix constructor for a [MapEntry].
     *
     * `1 to "a"` is sugar for `std::mapEntry(1, "a")`, so map factories read
     * naturally: `std::hashMapOf(1 to "a", 2 to "b")`.
     */
    @Experimental(since: "0.0.4")
    macro .Infix("to") {
        $a $b => std::mapEntry($a, $b)
    }

    @Experimental(since: "0.0.4")
    func hashMapOf<K, V>(...entries: MapEntry<K, V>): HashMap<K, V> {
        var result = HashMap<K, V>()
        for i in 0..<entries.size {
            result.put(entries[i].key, entries[i].value)
        }
        return result
    }

    @Experimental(since: "0.0.4")
    func linkedHashMapOf<K, V>(...entries: MapEntry<K, V>): LinkedHashMap<K, V> {
        var result = LinkedHashMap<K, V>()
        for i in 0..<entries.size {
            result.put(entries[i].key, entries[i].value)
        }
        return result
    }

    @Experimental(since: "0.0.4")
    func treeMapOf<K, V>(...entries: MapEntry<K, V>): TreeMap<K, V> {
        var result = TreeMap<K, V>()
        for i in 0..<entries.size {
            result.put(entries[i].key, entries[i].value)
        }
        return result
    }

    /**
     * Builds a read-only `Map<K, V>` from the supplied entries.
     *
     * Mirrors Kotlin's `mapOf`: the backing store is an insertion-ordered
     * `LinkedHashMap`, exposed through the read-only `Map` view. Equal keys
     * keep the last supplied value.
     */
    @Experimental(since: "0.0.4")
    func mapOf<K, V>(...entries: MapEntry<K, V>): Map<K, V> {
        var result = LinkedHashMap<K, V>()
        for i in 0..<entries.size {
            result.put(entries[i].key, entries[i].value)
        }
        return result
    }

    /**
     * Builds a `MutableMap<K, V>` from the supplied entries.
     *
     * Mirrors Kotlin's `mutableMapOf`: the backing store is an insertion-ordered
     * `LinkedHashMap`, exposed through the `MutableMap` view. Equal keys keep
     * the last supplied value.
     */
    @Experimental(since: "0.0.4")
    func mutableMapOf<K, V>(...entries: MapEntry<K, V>): MutableMap<K, V> {
        var result = LinkedHashMap<K, V>()
        for i in 0..<entries.size {
            result.put(entries[i].key, entries[i].value)
        }
        return result
    }

    @Experimental(since: "0.0.4")
    func emptyMap<K, V>(): Map<K, V> {
        return LinkedHashMap<K, V>()
    }

    @Experimental(since: "0.0.4")
    func emptyMutableMap<K, V>(): MutableMap<K, V> {
        return LinkedHashMap<K, V>()
    }

    @Experimental(since: "0.0.4")
    func emptyHashMap<K, V>(): MutableMap<K, V> {
        return HashMap<K, V>()
    }

    @Experimental(since: "0.0.4")
    func emptyLinkedHashMap<K, V>(): MutableMap<K, V> {
        return LinkedHashMap<K, V>()
    }

    @Experimental(since: "0.0.4")
    func emptyTreeMap<K, V>(): MutableMap<K, V> {
        return TreeMap<K, V>()
    }

    // ---------------------------------------------------------------------
    // Operators
    // ---------------------------------------------------------------------

    @Experimental(since: "0.0.4")
    oper[] [self: HashMap<K, V>&](key: K): V {
        return self.get(key)
    }

    @Experimental(since: "0.0.4")
    oper[]= [self: HashMap<K, V>!](key: K, value: V) {
        self.put(key, value)
    }

    @Experimental(since: "0.0.4")
    oper[] [self: LinkedHashMap<K, V>&](key: K): V {
        return self.get(key)
    }

    @Experimental(since: "0.0.4")
    oper[]= [self: LinkedHashMap<K, V>!](key: K, value: V) {
        self.put(key, value)
    }

    @Experimental(since: "0.0.4")
    oper[] [self: TreeMap<K, V>&](key: K): V {
        return self.get(key)
    }

    @Experimental(since: "0.0.4")
    oper[]= [self: TreeMap<K, V>!](key: K, value: V) {
        self.put(key, value)
    }

    /** Slicing is over current iteration order and returns an ordered snapshot. */
    @Experimental(since: "0.0.4")
    oper[:] [self: HashMap<K, V>&](slice: MapSlice): Map<K, V> {
        assert slice.step != 0 { "Map slice step cannot be zero" }
        fin all = self.entries()
        var result = LinkedHashMap<K, V>()
        var i = slice.start
        while (slice.step > 0 && i < slice.end) || (slice.step < 0 && i > slice.end) {
            if i >= 0 && i < all.size {
                result.put(all[i].key, all[i].value)
            }
            i += slice.step
        }
        return result
    }

    @Experimental(since: "0.0.4")
    oper[:] [self: LinkedHashMap<K, V>&](slice: MapSlice): Map<K, V> {
        assert slice.step != 0 { "Map slice step cannot be zero" }
        var result = LinkedHashMap<K, V>()
        var i = slice.start
        while (slice.step > 0 && i < slice.end) || (slice.step < 0 && i > slice.end) {
            if i >= 0 && i < self.__size {
                result.put(self.keys[i], self.values[i])
            }
            i += slice.step
        }
        return result
    }

    @Experimental(since: "0.0.4")
    oper[:] [self: TreeMap<K, V>&](slice: MapSlice): Map<K, V> {
        assert slice.step != 0 { "Map slice step cannot be zero" }
        fin all = self.entries()
        var result = LinkedHashMap<K, V>()
        var i = slice.start
        while (slice.step > 0 && i < slice.end) || (slice.step < 0 && i > slice.end) {
            if i >= 0 && i < all.size {
                result.put(all[i].key, all[i].value)
            }
            i += slice.step
        }
        return result
    }

    @Experimental(since: "0.0.4")
    oper+ [self: HashMap<K, V>&](entry: MapEntry<K, V>): Map<K, V> {
        var result = hashMapOf<K, V>()
        result.putAll(self)
        result.put(entry.key, entry.value)
        return result
    }

    @Experimental(since: "0.0.4")
    oper- [self: HashMap<K, V>&](key: K): Map<K, V> {
        var result = hashMapOf<K, V>()
        result.putAll(self)
        result.remove(key)
        return result
    }

    @Experimental(since: "0.0.4")
    oper+ [self: LinkedHashMap<K, V>&](entry: MapEntry<K, V>): Map<K, V> {
        var result = linkedHashMapOf<K, V>()
        result.putAll(self)
        result.put(entry.key, entry.value)
        return result
    }

    @Experimental(since: "0.0.4")
    oper- [self: LinkedHashMap<K, V>&](key: K): Map<K, V> {
        var result = linkedHashMapOf<K, V>()
        result.putAll(self)
        result.remove(key)
        return result
    }

    @Experimental(since: "0.0.4")
    oper+ [self: TreeMap<K, V>&](entry: MapEntry<K, V>): Map<K, V> {
        var result = treeMapOf<K, V>()
        result.putAll(self)
        result.put(entry.key, entry.value)
        return result
    }

    @Experimental(since: "0.0.4")
    oper- [self: TreeMap<K, V>&](key: K): Map<K, V> {
        var result = treeMapOf<K, V>()
        result.putAll(self)
        result.remove(key)
        return result
    }

    @Experimental(since: "0.0.4")
    oper== [self: HashMap<K, V>&](rhs: Map<K, V>): Bool {
        if self.size != rhs.size { return false }
        fin all = self.entries()
        for i in 0..<all.size {
            if !rhs.containsKey(all[i].key) || rhs.get(all[i].key) != all[i].value {
                return false
            }
        }
        return true
    }

    @Experimental(since: "0.0.4")
    oper!= [self: HashMap<K, V>&](rhs: Map<K, V>): Bool {
        return !(self == rhs)
    }

    @Experimental(since: "0.0.4")
    oper# [self: HashMap<K, V>&]: ULong {
        fin all = self.entries()
        var result = 0 as ULong
        for i in 0..<all.size {
            result = result + (#all[i].key ^ #all[i].value)
        }
        return result
    }

    @Experimental(since: "0.0.4")
    oper== [self: LinkedHashMap<K, V>&](rhs: Map<K, V>): Bool {
        if self.size != rhs.size { return false }
        for i in 0..<self.__size {
            if !rhs.containsKey(self.keys[i]) || rhs.get(self.keys[i]) != self.values[i] {
                return false
            }
        }
        return true
    }

    @Experimental(since: "0.0.4")
    oper!= [self: LinkedHashMap<K, V>&](rhs: Map<K, V>): Bool {
        return !(self == rhs)
    }

    @Experimental(since: "0.0.4")
    oper# [self: LinkedHashMap<K, V>&]: ULong {
        var result = 0 as ULong
        for i in 0..<self.__size {
            result = result + (#self.keys[i] ^ #self.values[i])
        }
        return result
    }

    @Experimental(since: "0.0.4")
    oper== [self: TreeMap<K, V>&](rhs: Map<K, V>): Bool {
        if self.size != rhs.size { return false }
        fin all = self.entries()
        for i in 0..<all.size {
            if !rhs.containsKey(all[i].key) || rhs.get(all[i].key) != all[i].value { return false }
        }
        return true
    }

    @Experimental(since: "0.0.4")
    oper!= [self: TreeMap<K, V>&](rhs: Map<K, V>): Bool {
        return !(self == rhs)
    }

    @Experimental(since: "0.0.4")
    oper# [self: TreeMap<K, V>&]: ULong {
        fin all = self.entries()
        var result = 0 as ULong
        for i in 0..<all.size {
            result = result + (#all[i].key ^ #all[i].value)
        }
        return result
    }
}

test "hash map stores and retrieves by key" {
    var m = HashMap<Int, String>()
    m.put(1, "a")
    m.put(2, "b")
    assert m.size == 2 { "hash map size changed" }
    assert m.get(1) == "a" && m.get(2) == "b" { "hash map retrieval changed" }
    assert m.containsKey(2) && !m.containsKey(9) { "hash map containsKey changed" }
}

test "hash map put replaces existing keys" {
    var m = HashMap<Int, String>()
    m.put(1, "a")
    m.put(1, "b")
    assert m.size == 1 && m.get(1) == "b" { "put must replace, not insert" }
}

test "hash map remove and clear purge entries" {
    var m = HashMap<Int, String>()
    m.put(1, "a")
    m.put(2, "b")
    m.remove(1)
    assert m.size == 1 && !m.containsKey(1) { "remove must purge the entry" }
    m.clear()
    assert m.isEmpty { "clear must empty the map" }
}

test "hash map containsValue and getOrDefault" {
    var m = HashMap<Int, String>()
    m.put(1, "a")
    assert m.containsValue("a") && !m.containsValue("z") { "containsValue changed" }
    assert m.getOrDefault(1, "z") == "a" { "getOrDefault must return the stored value" }
    assert m.getOrDefault(9, "z") == "z" { "getOrDefault must return the default" }
}

test "hash map index operators read and write" {
    var m = HashMap<Int, String>()
    m[1] = "a"
    m[2] = "b"
    assert m.size == 2 && m[1] == "a" && m[2] == "b" { "index operators changed" }
}

test "linked hash map preserves insertion order" {
    var m = LinkedHashMap<Int, String>()
    m.put(3, "c")
    m.put(1, "a")
    m.put(2, "b")
    fin keys = m.keys()
    assert keys.size == 3 && keys.get(0) == 3 && keys.get(1) == 1 && keys.get(2) == 2 { "linked hash map order changed" }
}

test "tree map keeps keys sorted" {
    var m = TreeMap<Int, String>()
    m.put(3, "c")
    m.put(1, "a")
    m.put(2, "b")
    fin keys = m.keys()
    assert keys.size == 3 && keys.get(0) == 1 && keys.get(1) == 2 && keys.get(2) == 3 { "tree map sort order changed" }
}

test "tree map navigation finds neighbors" {
    var m = TreeMap<Int, String>()
    m.put(1, "a")
    m.put(3, "c")
    m.put(5, "e")
    assert m.firstKey() == 1 && m.lastKey() == 5 { "tree map extrema changed" }
    assert m.lowerKey(3) == 1 { "lowerKey changed" }
    assert m.higherKey(3) == 5 { "higherKey changed" }
    assert m.floorKey(3) == 3 { "floorKey changed" }
    assert m.ceilingKey(3) == 3 { "ceilingKey changed" }
}

test "tree map polling removes the extremes" {
    var m = TreeMap<Int, String>()
    m.put(1, "a")
    m.put(2, "b")
    m.put(3, "c")
    m.pollFirstEntry()
    m.pollLastEntry()
    assert m.size == 1 && m.firstKey() == 2 { "polling must leave only the middle" }
}

test "factories build maps from entries" {
    fin hm = std::hashMapOf(1 to "a", 2 to "b")
    fin lhm = std::linkedHashMapOf(1 to "a", 2 to "b")
    fin tm = std::treeMapOf(1 to "a", 2 to "b")
    assert hm.size == 2 && lhm.size == 2 && tm.size == 2 { "factory sizes changed" }
    assert hm.get(1) == "a" && lhm.get(2) == "b" && tm.get(1) == "a" { "factory retrieval changed" }
}

test "mapOf exposes a read-only Map" {
    fin m = std::mapOf(1 to "a", 2 to "b")
    assert m.size == 2 { "mapOf size changed" }
    assert m.containsKey(1) && m.get(1) == "a" { "mapOf must store entries read-only" }
}

test "mutableMapOf allows in-place mutation" {
    var m = std::mutableMapOf(1 to "a")
    m.put(2, "b")
    m.remove(1)
    assert m.size == 1 && m.get(2) == "b" { "mutableMapOf mutation changed" }
}

test "map plus and minus derive new maps" {
    var origin = HashMap<Int, String>()
    origin.put(1, "a")
    fin grown = origin + (2 to "b")
    fin shrunk = origin - 1
    assert grown.size == 2 && grown.get(2) == "b" { "oper+ must add the entry" }
    assert shrunk.size == 0 { "oper- must remove the key" }
    assert origin.size == 1 { "derivation must not mutate the source" }
}

test "map equality compares entries not identity" {
    var a = HashMap<Int, String>()
    a.put(1, "a")
    var b = HashMap<Int, String>()
    b.put(1, "a")
    assert a == b { "maps with equal entries must be equal" }
    b.put(2, "b")
    assert a != b { "differing maps must be unequal" }
}

test .All "map"
