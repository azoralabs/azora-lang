/**
 * @file std/quantum.az
 *
 * Backend-neutral quantum circuits and small algorithm builders.
 *
 * This module constructs circuits; it does not perform execution by itself.
 * `connect` and `execute` are bridge declarations implemented by a simulator,
 * OpenQASM exporter, or a vendor-specific QPU adapter.
 *
 * @since 0.1
 */
@Supress(.Unused)
module std.quantum

import std::{
    container::{array::*, list::*}
    math::*
}

/** The operation vocabulary understood by the portable circuit IR. */
@Experimental(since: "0.1")
enum GateKind {
    Identity
    X
    Y
    Z
    H
    S
    T
    Rx
    Ry
    Rz
    Phase
    CNot
    ControlledPhase
    Swap
    Measure
    MultiControlledZ
    ClassicalX
    ClassicalZ
}

/** Measurement basis for a backend that supports basis selection. */
@Experimental(since: "0.1")
enum MeasurementBasis {
    Z
    X
    Y
}

/** One portable gate or measurement operation. */
@Experimental(since: "0.1")
pack Gate {
    var kind: GateKind
    var target: Int
    var control: Int
    var parameter: Double
}

/** An owned, ordered sequence of operations over a fixed qubit count. */
@Experimental(since: "0.1")
pack Circuit {
    var qubits: Int
    var gates: ArrayList<Gate>
}

/** One measured bit string and the number of shots that produced it. */
@Experimental(since: "0.1")
pack Sample {
    var bits: Array<Int>
    var count: Int
}

/** Opaque connection to a simulator, exporter, or physical QPU. */
@Experimental(since: "0.1")
bridge pack QuantumDevice

/** Creates an empty circuit with [qubits] logical qubits. */
@Experimental(since: "0.1")
func circuit(qubits: Int): Circuit
in assert qubits > 0 panic "a quantum circuit needs at least one qubit"
scope return .(qubits, ArrayList<Gate>())

impl Circuit {
    /** Adds a fully specified operation to the circuit. */
    @Experimental(since: "0.1")
    func !.add(operation: Gate) {
        assert operation.target >= 0 && operation.target < self.qubits panic "gate target is outside the circuit"
        if operation.control >= 0 && operation.kind != .ClassicalX &&
            operation.kind != .ClassicalZ {
            assert operation.control < self.qubits panic "gate control is outside the circuit"
        }
        self.gates.add(operation)
    }

    /** Appends a Hadamard gate. */
    @Experimental(since: "0.1")
    func !.h(target: Int) scope self.add(Gate(.H, target, -1, 0.0))

    /** Appends a Pauli-X gate. */
    @Experimental(since: "0.1")
    func !.x(target: Int) scope self.add(Gate(.X, target, -1, 0.0))

    /** Appends a Pauli-Y gate. */
    @Experimental(since: "0.1")
    func !.y(target: Int) scope self.add(Gate(.Y, target, -1, 0.0))

    /** Appends a Pauli-Z gate. */
    @Experimental(since: "0.1")
    func !.z(target: Int) scope self.add(Gate(.Z, target, -1, 0.0))

    /** Appends an arbitrary-angle X rotation, in radians. */
    @Experimental(since: "0.1")
    func !.rotateX(target: Int, angle: Double) scope self.add(Gate(.Rx, target, -1, angle))

    /** Appends an arbitrary-angle Y rotation, in radians. */
    @Experimental(since: "0.1")
    func !.rotateY(target: Int, angle: Double) scope self.add(Gate(.Ry, target, -1, angle))

    /** Appends an arbitrary-angle Z rotation, in radians. */
    @Experimental(since: "0.1")
    func !.rotateZ(target: Int, angle: Double) scope self.add(Gate(.Rz, target, -1, angle))

    /** Appends a controlled-NOT gate. */
    @Experimental(since: "0.1")
    func !.cnot(control: Int, target: Int)
    in assert control != target panic "a controlled gate needs two qubits"
    scope self.add(Gate(.CNot, target, control, 0.0))

    /** Appends a controlled phase rotation, in radians. */
    @Experimental(since: "0.1")
    func !.controlledPhase(control: Int, target: Int, angle: Double)
    in assert control != target panic "a controlled gate needs two qubits"
    scope self.add(Gate(.ControlledPhase, target, control, angle))

    /** Appends a swap gate. */
    @Experimental(since: "0.1")
    func !.swap(first: Int, second: Int)
    in assert first != second panic "a swap gate needs two qubits"
    scope self.add(Gate(.Swap, first, second, 0.0))

    /** Appends a measurement in the requested basis. */
    @Experimental(since: "0.1")
    func !.measure(target: Int, basis: MeasurementBasis): Unit
    scope self.add(Gate(.Measure, target, -1, when {
        basis == MeasurementBasis.X -> 1.0
        basis == MeasurementBasis.Y -> 2.0
        else -> 0.0
    }))

    /** Appends the portable marked-state phase oracle used by Grover. */
    @Experimental(since: "0.1")
    func !.markState(state: Int) scope self.add(Gate(.MultiControlledZ, 0, -1, state as Double))

    /** Appends a classical feed-forward X correction. */
    @Experimental(since: "0.1")
    func !.classicalX(target: Int, bit: Int) scope self.add(Gate(.ClassicalX, target, bit, 0.0))

    /** Appends a classical feed-forward Z correction. */
    @Experimental(since: "0.1")
    func !.classicalZ(target: Int, bit: Int) scope self.add(Gate(.ClassicalZ, target, bit, 0.0))
}

/** Connects to a backend by name; the target supplies the implementation. */
@Experimental(since: "0.1")
bridge func connect(backend: String): QuantumDevice

/** Executes a circuit and returns counts grouped by measured bit string. */
@Experimental(since: "0.1")
bridge func execute(device: QuantumDevice, circuit: Circuit, shots: Int): Array<Sample>

/** Returns the recommended Grover iteration count for one marked state. */
@Experimental(since: "0.1")
func groverIterations(qubits: Int): Int
in assert qubits > 0 panic "Grover search needs at least one qubit"
scope {
    fin states: Int = 1 << qubits
    fin estimate: Int = (PI * sqrt(states as Double) / 4.0) as Int
    return if estimate < 1 then 1 else estimate
}

/** Creates a two-qubit Bell-state preparation and measurement circuit. */
@Experimental(since: "0.1")
func bellPair(): Circuit {
    var result = circuit(2)
    result.h(0)
    result.cnot(0, 1)
    result.measure(0, MeasurementBasis.Z)
    result.measure(1, MeasurementBasis.Z)
    return result
}

/** Creates the three-qubit teleportation protocol with feed-forward nodes. */
@Experimental(since: "0.1")
func teleportation(): Circuit {
    var result = circuit(3)
    result.h(1)
    result.cnot(1, 2)
    result.cnot(0, 1)
    result.h(0)
    result.measure(0, MeasurementBasis.Z)
    result.measure(1, MeasurementBasis.Z)
    result.classicalX(2, 1)
    result.classicalZ(2, 0)
    return result
}

/**
 * Creates a Deutsch-Jozsa circuit for the parity oracle selected by [mask].
 * Zero is the constant-zero oracle; any non-zero mask is balanced.
 */
@Experimental(since: "0.1")
func deutschJozsa(qubits: Int, mask: Int): Circuit {
    assert qubits > 0 panic "Deutsch-Jozsa needs at least one input qubit"
    var result: Circuit = circuit(qubits + 1)
    result.x(qubits)
    for i: Int in 0..<qubits then result.h(i)
    result.h(qubits)
    for i: Int in 0..<qubits then if (mask & (1 << i)) != 0 then result.cnot(i, qubits)
    for i: Int in 0..<qubits {
        result.h(i)
        result.measure(i, MeasurementBasis.Z)
    }
    return result
}

/** Creates the Bernstein-Vazirani circuit for a hidden classical bit string. */
@Experimental(since: "0.1")
func bernsteinVazirani(secret: Array<Int>): Circuit
in assert secret.size > 0 panic "Bernstein-Vazirani needs a non-empty secret"
scope {
    var result: Circuit = circuit(secret.size + 1)
    fin ancilla = secret.size
    result.x(ancilla)
    for i: Int in 0..<secret.size then result.h(i)
    result.h(ancilla)
    for i: Int in 0..<secret.size then if secret[i] != 0 then result.cnot(i, ancilla)
    for i: Int in 0..<secret.size {
        result.h(i)
        result.measure(i, MeasurementBasis.Z)
    }
    return result
}

/** Creates Grover search for one marked computational-basis state. */
@Experimental(since: "0.1")
func groverSearch(qubits: Int, markedState: Int): Circuit
in {
    assert qubits > 0 panic "Grover search needs at least one qubit"
    assert markedState >= 0 && markedState < (1 << qubits) panic "Grover marked state is outside the search space"
} scope {
    var result: Circuit = circuit(qubits)
    for i: Int in 0..<qubits then result.h(i)
    fin rounds: Int = groverIterations(qubits)
    for i: Int in 0..<rounds {
        result.markState(markedState)
        for j: Int in 0..<qubits then result.{h(j), x(j)}
        result.markState(0)
        for j: Int in 0..<qubits then result.{x(j), h(j)}
    }
    for i: Int in 0..<qubits then result.measure(i, MeasurementBasis.Z)
    return result
}

/** Creates the quantum Fourier transform over [qubits] input qubits. */
@Experimental(since: "0.1")
func quantumFourierTransform(qubits: Int): Circuit {
    assert qubits > 0 panic "the quantum Fourier transform needs qubits"
    var result: Circuit = circuit(qubits)
    for i: Int in 0..<qubits {
        result.h(i)
        var distance: Int = 1
        while i + distance < qubits {
            fin denominator = (1 << distance) as Double
            result.controlledPhase(i + distance++, i, PI / denominator)
        }
    }
    for left: Int in 0..<qubits / 2 then result.swap(left, qubits - left - 1)
    return result
}
