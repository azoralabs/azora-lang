/**
 * @file std/serializer.az
 *
 * Deterministic, format-independent serialization primitives.
 *
 * A `Serializer<T>` converts a typed value to and from `SerialValue`. The text
 * format is a separate concern: `encodeSerialValue` and `decodeSerialValue`
 * handle canonical AZON, the one format the standard library ships. This
 * separation lets an application reuse one typed serializer with a wire format
 * of its own, and makes custom serializers straightforward for values owned by
 * another library.
 *
 * AZON is the only built-in format. Any other - JSON, CBOR, YAML, a private
 * wire format - is written outside the standard library by implementing
 * `Serializer<T>` and encoding the resulting `SerialValue`.
 *
 * Numbers are retained as validated source text instead of being converted to
 * `Double`; this prevents precision loss for large integers and decimal values.
 * Object fields preserve insertion order. Duplicate fields are rejected while
 * decoding unless explicitly enabled in `SerializerOptions`.
 *
 * This API is experimental, but its wire-format rules are intentionally strict
 * so data written today can remain readable as the implementation evolves.
 */
@Supress(.Unused)
module std.serializer

import std::{
    container.list::*
    char::*
    string::*
}

/** Failures reported by text decoders and typed serializers. */
@Experimental(since: "0.1")
error SerializationError {
    InvalidSyntax
    InvalidEscape
    InvalidNumber
    UnexpectedEnd
    TrailingContent
    DuplicateField
    MissingField
    UnknownField
    UnexpectedType
    MaxDepthExceeded
    InputTooLarge
}

/**
 * Marks a pack for compiler-generated value-tree and AZON codecs.
 *
 * Use `AzonSerializable` when only the text form is part of a type's public
 * contract. Configuration is immutable compile-time metadata and can be
 * inspected from inline code with
 * `reflect<value>.annotMeta<Serializable>.ignoreUnknownFields`.
*/
@Experimental(since: "0.1")
@Derive(
    generator: "serializer",
    role: "all",
    provider: "std",
    conversionProvider: "convert",
    providerModule: "std.serializer",
    conversionModule: "std.convert",
    listModule: "std.container.list",
    deferGeneric: true
)
annot @Serializable for .Pack binds (Serializer, AzonSerializer) {
    /** Accepts object members which do not map to an exposed pack field. */
    fin ignoreUnknownFields: Bool = false

    /** Includes fields whose value is equal to the declared default. */
    fin encodeDefaults: Bool = true
}

/** Marks a pack for compiler-generated AZON serialization only. */
@Experimental(since: "0.1")
@Derive(
    generator: "serializer",
    role: "azon",
    provider: "std",
    conversionProvider: "convert",
    providerModule: "std.serializer",
    conversionModule: "std.convert",
    listModule: "std.container.list",
    deferGeneric: true
)
annot @AzonSerializable for .Pack binds AzonSerializer {
    /** Accepts AZON object members which do not map to an exposed pack field. */
    fin ignoreUnknownFields: Bool = false

    /** Includes fields whose value is equal to the declared default. */
    fin encodeDefaults: Bool = true
}

/** Overrides the serialized name of a field or type. */
@Experimental(since: "0.1")
@Derive(generator: "serializer", role: "name")
annot @SerialName for [.Pack, .Enum, .Field] {
    /**
     * Name written to and read from the serialized representation.
     *
     * An empty value retains the declaration's source name. This makes the
     * marker form usable in grouped decorator implementations while an
     * explicit non-empty value performs an actual rename.
     */
    fin value: String = ""
}

/** Excludes a field from generated serialization and deserialization. */
@Experimental(since: "0.1")
@Derive(generator: "serializer", role: "ignore")
annot @SerialIgnore for .Field

/** Requires a field to be present even when its Azora field has a default. */
@Experimental(since: "0.1")
@Derive(generator: "serializer", role: "required")
annot @SerialRequired for .Field

/**
 * Resource and formatting limits for untrusted serialized input.
 *
 * `maxDepth` and `maxInputLength` are security limits. Applications should
 * lower them for protocols with known payload bounds.
 */
@Experimental(since: "0.1")
pack SerializerOptions {
    var pretty: Bool = false
    var indent: String = "  "
    var encodeNulls: Bool = true
    var allowDuplicateFields: Bool = false
    var maxDepth: Int = 64
    var maxInputLength: Int = 16777216
}

/** A named member in an ordered serialized object. */
@Experimental(since: "0.1")
pack SerialField {
    fin name: String
    fin value: SerialValue
}

/**
 * Lossless format-independent serialized data.
 *
 * `Number` stores a validated AZON number token. Object fields are ordered,
 * which provides deterministic output and permits duplicate detection before
 * a typed decoder consumes the value.
 */
@Experimental(since: "0.1")
variant enum SerialValue {
    Null
    Bool(value: Bool)
    Number(value: String)
    Text(value: String)
    Array(elements: List<SerialValue>)
    Object(fields: List<SerialField>)
}

/**
 * Bidirectional codec for `T`.
 *
 * Implement this spec when a type needs a custom representation. Generated
 * serializers created by `@Serializable` implement the same contract.
 * Implementations must not retain references to `value` after returning.
 *
 * @generic T The value type handled by this serializer.
 */
@Experimental(since: "0.1")
spec Serializer<T> {
    /** Converts a typed value into the format-independent value tree. */
    func &.toSerialValue(value: T&): SerialValue ?! SerializationError

    /** Reconstructs a typed value, validating all required fields and types. */
    func &.fromSerialValue(value: SerialValue&): T ?! SerializationError
}

/**
 * Bidirectional AZON codec for `T`.
 *
 * AZON writes `:` between object names and values. Generated
 * implementations created by `@Serializable` and `@AzonSerializable` use
 * this contract, and obey the same strict limits as `decodeSerialValue`.
 *
 * @generic T The value type handled by this AZON codec.
 */
@Experimental(since: "0.1")
spec AzonSerializer<T> {
    /** Encodes `value` as one complete AZON document. */
    func &.toAzon(value: T&, options: SerializerOptions&): String ?! SerializationError

    /** Decodes one complete AZON document into `T`. */
    func &.fromAzon(input: String, options: SerializerOptions&): T ?! SerializationError
}

/** Creates conservative defaults suitable for processing untrusted input. */
@Experimental(since: "0.1")
func serializerOptions(): SerializerOptions {
    return SerializerOptions()
}

/** Creates an exact number node after validating the number token. */
@Experimental(since: "0.1")
func serialNumber(value: String): SerialValue ?! SerializationError {
    if !isValidSerialNumber(value) {
        return .InvalidNumber
    }
    return SerialValue.Number(value)
}

/** Returns the named object field, or fails when it is absent. */
@Experimental(since: "0.1")
func serialField(value: SerialValue&, name: String): SerialValue ?! SerializationError {
    when value {
        SerialValue.Object(fields) -> {
            for i in 0..<fields.size {
                if fields[i].name == name {
                    return fields[i].value
                }
            }
            return .MissingField
        }
        else -> return .UnexpectedType
    }
}

/** Returns one typed object field by positional index. */
func serialFieldAt(fields: List<SerialField>&, index: Int): SerialField {
    return fields[index]
}

/** Returns one typed serialized array element by positional index. */
func serialValueAt(values: List<SerialValue>&, index: Int): SerialValue {
    return values[index]
}

/** Extracts a text value or reports an incompatible serialized type. */
@Experimental(since: "0.1")
func serialAsText(value: SerialValue&): String ?! SerializationError {
    return when value {
        .Text(text) -> text
        else -> .UnexpectedType
    }
}

/** Extracts a Boolean value or reports an incompatible serialized type. */
@Experimental(since: "0.1")
func serialAsBool(value: SerialValue&): Bool ?! SerializationError {
    return when value {
        .Bool(boolean) -> boolean
        else -> .UnexpectedType
    }
}

/** Extracts exactly one character from a serialized text value. */
@Experimental(since: "0.1")
func serialAsChar(value: SerialValue&): Char ?! SerializationError {
    fin text = try serialAsText(value)
    if stringLength(text) != 1 {
        return .UnexpectedType
    }
    return charAt(text, 0)
}

/**
 * Extracts a signed integral number with overflow checking.
 *
 * Fractional and exponent forms are rejected even though they are valid
 * serialized real numbers.
 */
@Experimental(since: "0.1")
func serialAsLong(value: SerialValue&): Long ?! SerializationError {
    when value {
        SerialValue.Number(text) -> {
            if stringLength(text) == 0 {
                return .InvalidNumber
            }
            if text == "-9223372036854775808" {
                fin minimum: Long = -9223372036854775807
                return minimum - 1
            }
            var index = 0
            var negative = false
            if charAt(text, index) == '-' {
                negative = true
                index += 1
            }
            if index >= stringLength(text) {
                return .InvalidNumber
            }
            var result: Long = 0
            while index < stringLength(text) {
                fin c = charAt(text, index)
                if !charIsDigit(c) {
                    return .InvalidNumber
                }
                fin digit = (charToCode(c) - 48) as Long
                if result > 922337203685477580 ||
                    (result == 922337203685477580 && digit > 7) {
                    return .InvalidNumber
                }
                result = result * 10 + digit
                index += 1
            }
            return if negative { 0 - result } else { result }
        }
        else -> return .UnexpectedType
    }
}

/** Extracts a range-checked signed byte. */
func serialAsByte(value: SerialValue&): Byte ?! SerializationError {
    fin parsed = try serialAsLong(value)
    if parsed < -128 || parsed > 127 {
        return .InvalidNumber
    }
    return parsed as Byte
}

/** Extracts a range-checked unsigned byte. */
func serialAsUByte(value: SerialValue&): UByte ?! SerializationError {
    fin parsed = try serialAsLong(value)
    if parsed < 0 || parsed > 255 {
        return .InvalidNumber
    }
    return parsed as UByte
}

/** Extracts a range-checked signed short. */
func serialAsShort(value: SerialValue&): Short ?! SerializationError {
    fin parsed = try serialAsLong(value)
    if parsed < -32768 || parsed > 32767 {
        return .InvalidNumber
    }
    return parsed as Short
}

/** Extracts a range-checked unsigned short. */
func serialAsUShort(value: SerialValue&): UShort ?! SerializationError {
    fin parsed = try serialAsLong(value)
    if parsed < 0 || parsed > 65535 {
        return .InvalidNumber
    }
    return parsed as UShort
}

/** Extracts a range-checked signed integer. */
func serialAsInt(value: SerialValue&): Int ?! SerializationError {
    fin parsed = try serialAsLong(value)
    if (parsed < 0 && parsed + 2147483648 < 0) || parsed > 2147483647 {
        return .InvalidNumber
    }
    return parsed as Int
}

/** Extracts a range-checked unsigned integer. */
func serialAsUInt(value: SerialValue&): UInt ?! SerializationError {
    fin parsed = try serialAsLong(value)
    if parsed < 0 || parsed > 4294967295 {
        return .InvalidNumber
    }
    return parsed as UInt
}

/** Extracts a non-negative value representable by the current ULong runtime. */
func serialAsULong(value: SerialValue&): ULong ?! SerializationError {
    fin parsed = try serialAsLong(value)
    if parsed < 0 {
        return .InvalidNumber
    }
    return parsed as ULong
}

/** Extracts a signed 128-bit value from the supported integer token range. */
func serialAsCent(value: SerialValue&): Cent ?! SerializationError {
    return try serialAsLong(value) as Cent
}

/** Extracts an unsigned 128-bit value from the supported integer token range. */
func serialAsUCent(value: SerialValue&): UCent ?! SerializationError {
    fin parsed = try serialAsLong(value)
    if parsed < 0 {
        return .InvalidNumber
    }
    return parsed as UCent
}

/** Extracts a finite real number, including fraction and exponent forms. */
@Experimental(since: "0.1")
func serialAsReal(value: SerialValue&): Double ?! SerializationError {
    when value {
        SerialValue.Number(text) -> {
            if !isValidSerialNumber(text) {
                return .InvalidNumber
            }
            var index = 0
            var sign = 1.0
            if charAt(text, index) == '-' {
                sign = -1.0
                index += 1
            }
            var result = 0.0
            while index < stringLength(text) && charIsDigit(charAt(text, index)) {
                result = result * 10.0 + (charToCode(charAt(text, index)) - 48) as Double
                index += 1
            }
            if index < stringLength(text) && charAt(text, index) == '.' {
                index += 1
                var divisor = 10.0
                while index < stringLength(text) && charIsDigit(charAt(text, index)) {
                    fin digit: Double = (charToCode(charAt(text, index)) - 48) as Double
                    result = result + digit / divisor
                    divisor *= 10.0
                    index += 1
                }
            }
            if index < stringLength(text) &&
                (charAt(text, index) == 'e' || charAt(text, index) == 'E') {
                index += 1
                var exponentNegative = false
                if index < stringLength(text) && charAt(text, index) == '+' {
                    index += 1
                }
                else if index < stringLength(text) && charAt(text, index) == '-' {
                    exponentNegative = true
                    index += 1
                }
                var exponent = 0
                while index < stringLength(text) {
                    exponent = exponent * 10 + charToCode(charAt(text, index)) - 48
                    index += 1
                }
                var factor = 1.0
                for power in 0..<exponent {
                    factor *= 10.0
                }
                result = if exponentNegative { result / factor } else { result * factor }
            }
            return sign * result
        }
        else -> return .UnexpectedType
    }
}

/** Encodes a value tree as canonical compact AZON. */
@Experimental(since: "0.1")
func encodeSerialValue(
    value: SerialValue&
    options: SerializerOptions&
): String ?! SerializationError {
    return try _encodeSerialValueAtDepth(value, options, 0)
}

/**
 * Decodes one complete AZON document.
 *
 * The decoder rejects trailing content, malformed UTF escapes, invalid
 * number grammar, excessive nesting, oversized input, and duplicate keys by
 * default.
 */
@Experimental(since: "0.1")
func decodeSerialValue(
    input: String
    options: SerializerOptions&
): SerialValue ?! SerializationError {
    if stringLength(input) > options.maxInputLength {
        return .InputTooLarge
    }
    var reader = _SerialReader(input, 0, options)
    fin value = try reader.readValue(0)
    reader.skipWhitespace()
    if !reader.isAtEnd {
        return .TrailingContent
    }
    return value
}

/** Internal cursor used by the strict text decoder. */
pack _SerialReader {
    var input: String
    var index: Int
    fin options: SerializerOptions
}

impl _SerialReader {
    prop &.isAtEnd: Bool = self.index >= stringLength(self.input)

    func !.skipWhitespace(): Unit {
        while !self.isAtEnd {
            fin c = charAt(self.input, self.index)
            if c != ' ' && c != '\n' && c != '\r' && c != '\t' {
                return
            }
            self.index += 1
        }
    }

    func !.take(): Char ?! SerializationError {
        if self.isAtEnd {
            return .UnexpectedEnd
        }
        fin c = charAt(self.input, self.index)
        self.index += 1
        return c
    }

    func !.expect(expected: Char): Unit ?! SerializationError {
        fin actual = try self.take()
        if actual != expected {
            return .InvalidSyntax
        }
    }

    func !.readValue(depth: Int): SerialValue ?! SerializationError {
        if depth > self.options.maxDepth {
            return .MaxDepthExceeded
        }
        self.skipWhitespace()
        if self.isAtEnd {
            return .UnexpectedEnd
        }
        fin c = charAt(self.input, self.index)
        if c == '"' {
            return SerialValue.Text(try self.readString())
        }
        if c == '[' {
            return try self.readArray(depth + 1)
        }
        if c == '{' {
            return try self.readObject(depth + 1)
        }
        if c == 't' {
            try self.readLiteral("true")
            return SerialValue.Bool(true)
        }
        if c == 'f' {
            try self.readLiteral("false")
            return SerialValue.Bool(false)
        }
        if c == 'n' {
            try self.readLiteral("null")
            return SerialValue.Null
        }
        if c == '-' || (c >= '0' && c <= '9') {
            return SerialValue.Number(try self.readNumber())
        }
        return .InvalidSyntax
    }

    func !.readLiteral(expected: String): Unit ?! SerializationError {
        for i in 0..<stringLength(expected) {
            if try self.take() != charAt(expected, i) {
                return .InvalidSyntax
            }
        }
    }

    func !.readString(): String ?! SerializationError {
        try self.expect('"')
        var result = ""
        while !self.isAtEnd {
            fin c = try self.take()
            if c == '"' {
                return result
            }
            if charToCode(c) < 32 {
                return .InvalidEscape
            }
            if c != '\\' {
                result += c as String
            } else {
                fin escaped = try self.take()
                if escaped == '"' { result = result + "\"" }
                else if escaped == '\\' { result = result + "\\" }
                else if escaped == '/' { result = result + "/" }
                else if escaped == 'b' { result = result + "\b" }
                else if escaped == 'f' { result = result + "\f" }
                else if escaped == 'n' { result = result + "\n" }
                else if escaped == 'r' { result = result + "\r" }
                else if escaped == 't' { result = result + "\t" }
                else if escaped == 'u' {
                    fin codePoint = try self.readEscapedCodePoint()
                    result += codeToChar(codePoint) as String
                } else {
                    return .InvalidEscape
                }
            }
        }
        return .UnexpectedEnd
    }

    func !.readHexUnit(): Int ?! SerializationError {
        var value = 0
        for i in 0..<4 {
            fin c = try self.take()
            if !charIsHexDigit(c) {
                return .InvalidEscape
            }
            value = value * 16 + hexDigitToInt(c)
        }
        return value
    }

    func !.readEscapedCodePoint(): Int ?! SerializationError {
        fin first = try self.readHexUnit()
        if first >= 56320 && first <= 57343 {
            return .InvalidEscape
        }
        if first < 55296 || first > 56319 {
            return first
        }

        // A high surrogate must be immediately followed by a low surrogate.
        if try self.take() != '\\' || try self.take() != 'u' {
            return .InvalidEscape
        }
        fin second = try self.readHexUnit()
        if second < 56320 || second > 57343 {
            return .InvalidEscape
        }
        return 65536 + (first - 55296) * 1024 + (second - 56320)
    }

    func !.readNumber(): String ?! SerializationError {
        fin start = self.index
        if charAt(self.input, self.index) == '-' {
            self.index += 1
        }
        if self.isAtEnd {
            return .InvalidNumber
        }

        if charAt(self.input, self.index) == '0' {
            self.index += 1
        } else {
            if !charIsDigit(charAt(self.input, self.index)) {
                return .InvalidNumber
            }
            while !self.isAtEnd && charIsDigit(charAt(self.input, self.index)) {
                self.index += 1
            }
        }

        if !self.isAtEnd && charAt(self.input, self.index) == '.' {
            self.index += 1
            if self.isAtEnd || !charIsDigit(charAt(self.input, self.index)) {
                return .InvalidNumber
            }
            while !self.isAtEnd && charIsDigit(charAt(self.input, self.index)) {
                self.index += 1
            }
        }

        if !self.isAtEnd && (charAt(self.input, self.index) == 'e' || charAt(self.input, self.index) == 'E') {
            self.index += 1
            if !self.isAtEnd && (charAt(self.input, self.index) == '+' || charAt(self.input, self.index) == '-') {
                self.index += 1
            }
            if self.isAtEnd || !charIsDigit(charAt(self.input, self.index)) {
                return .InvalidNumber
            }
            while !self.isAtEnd && charIsDigit(charAt(self.input, self.index)) {
                self.index += 1
            }
        }
        return substring(self.input, start, self.index)
    }

    func !.readArray(depth: Int): SerialValue ?! SerializationError {
        try self.expect('[')
        var values: ArrayList<SerialValue> = .()
        self.skipWhitespace()
        if !self.isAtEnd && charAt(self.input, self.index) == ']' {
            self.index += 1
            return SerialValue.Array(values)
        }
        loop {
            values.add(try self.readValue(depth))
            self.skipWhitespace()
            fin separator = try self.take()
            if separator == ']' {
                return SerialValue.Array(values)
            }
            if separator != ',' {
                return .InvalidSyntax
            }
            self.skipWhitespace()
        }
    }

    func !.readObject(depth: Int): SerialValue ?! SerializationError {
        try self.expect('{')
        var fields: ArrayList<SerialField> = .()
        self.skipWhitespace()
        if !self.isAtEnd && charAt(self.input, self.index) == '}' {
            self.index += 1
            return SerialValue.Object(fields)
        }
        loop {
            self.skipWhitespace()
            if self.isAtEnd || charAt(self.input, self.index) != '"' {
                return .InvalidSyntax
            }
            fin name = try self.readString()
            self.skipWhitespace()
            try self.expect(':')
            self.skipWhitespace()
            fin value = try self.readValue(depth)

            var duplicate = false
            for i in 0..<fields.size {
                if serialFieldAt(fields, i).name == name {
                    duplicate = true
                }
            }
            if duplicate && !self.options.allowDuplicateFields {
                return .DuplicateField
            }
            fields.add(SerialField(name, value))

            self.skipWhitespace()
            fin separator = try self.take()
            when separator {
                '}' -> return .Object(fields)
                ',' -> return .InvalidSyntax
            }
            self.skipWhitespace()
        }
    }
}

func _encodeSerialValueAtDepth(
    value: SerialValue&
    options: SerializerOptions&
    depth: Int
): String ?! SerializationError {
    if depth > options.maxDepth {
        return .MaxDepthExceeded
    }
    when value {
        .Null -> { return "null" }
        .Bool(v) -> { return if v { "true" } else { "false" } }
        .Number(v) -> {
            if !isValidSerialNumber(v) {
                return .InvalidNumber
            }
            return v
        }
        .Text(v) -> { return _quoteSerialString(v) }
        .Array(values) -> {
            var result = "["
            for i in 0..<values.size {
                if i > 0 {
                    result += ","
                }
                if options.pretty {
                    result += "\n" + _repeatIndent(options.indent, depth + 1)
                }
                result += try _encodeSerialValueAtDepth(values[i], options, depth + 1)
            }
            if options.pretty && values.size > 0 {
                result += "\n" + _repeatIndent(options.indent, depth)
            }
            return result + "]"
        }
        .Object(fields) -> {
            var result = "{"
            var i = 0
            var written = 0
            while i < fields.size {
                fin field = serialFieldAt(fields, i)
                var include = true
                if field.value == .Null {
                    include = options.encodeNulls
                }
                if include {
                    if written > 0 {
                        result += ","
                    }
                    if options.pretty {
                        result += "\n" + _repeatIndent(options.indent, depth + 1)
                    }
                    result += _quoteSerialString(field.name) + ":"
                    if options.pretty {
                        result += " "
                    }
                    result += try _encodeSerialValueAtDepth(field.value, options, depth + 1)
                    written += 1
                }
                i += 1
            }
            if options.pretty && written > 0 {
                result += "\n" + _repeatIndent(options.indent, depth)
            }
            return result + "}"
        }
    }
    return .UnexpectedType
}

func _quoteSerialString(value: String): String {
    var result = "\""
    for i in 0..<stringLength(value) {
        fin c = charAt(value, i)
        if c == '"' { result = result + "\\\"" }
        else if c == '\\' { result = result + "\\\\" }
        else if c == '\b' { result = result + "\\b" }
        else if c == '\f' { result = result + "\\f" }
        else if c == '\n' { result = result + "\\n" }
        else if c == '\r' { result = result + "\\r" }
        else if c == '\t' { result = result + "\\t" }
        else if charToCode(c) < 32 { result = result + "\\u" + _hex4(charToCode(c)) }
        else { result += c as String }
    }
    return result + "\""
}

func _repeatIndent(indent: String, count: Int): String {
    var result = ""
    for i in 0..<count {
        result += indent
    }
    return result
}

func _hex4(value: Int): String {
    fin digits = "0123456789abcdef"
    return charAt(digits, (value / 4096) % 16) as String +
        charAt(digits, (value / 256) % 16) as String +
        charAt(digits, (value / 16) % 16) as String +
        charAt(digits, value % 16) as String
}

/** Validates the complete AZON number grammar without converting it. */
@Experimental(since: "0.1")
func isValidSerialNumber(value: String): Bool {
    if stringLength(value) == 0 {
        return false
    }
    var i = 0
    if charAt(value, i) == '-' {
        i += 1
    }
    if i >= stringLength(value) {
        return false
    }
    if charAt(value, i) == '0' {
        i += 1
    } else {
        if !charIsDigit(charAt(value, i)) {
            return false
        }
        while i < stringLength(value) && charIsDigit(charAt(value, i)) {
            i += 1
        }
    }
    if i < stringLength(value) && charAt(value, i) == '.' {
        i += 1
        if i >= stringLength(value) || !charIsDigit(charAt(value, i)) {
            return false
        }
        while i < stringLength(value) && charIsDigit(charAt(value, i)) {
            i += 1
        }
    }
    if i < stringLength(value) && (charAt(value, i) == 'e' || charAt(value, i) == 'E') {
        i += 1
        if i < stringLength(value) && (charAt(value, i) == '+' || charAt(value, i) == '-') {
            i += 1
        }
        if i >= stringLength(value) || !charIsDigit(charAt(value, i)) {
            return false
        }
        while i < stringLength(value) && charIsDigit(charAt(value, i)) {
            i += 1
        }
    }
    return i == stringLength(value)
}

test scope {
    @Serializable(ignoreUnknownFields: true, encodeDefaults: false)
    pack SerializerMetadataFixture {
        @SerialIgnore
        fin secret: String = ""

        @SerialName("display_name")
        fin displayName: String
    }

    @AzonSerializable(ignoreUnknownFields: true, encodeDefaults: true)
    pack _AzonMetadataFixture

    pack _ManualTextValue {
        fin value: String
    }

    pack _ManualTextSerializer

    impl Serializer<_ManualTextValue> for _ManualTextSerializer {
        func &.toSerialValue(
            value: _ManualTextValue&
        ): SerialValue ?! SerializationError {
            return .Text(value.value)
        }

        func &.fromSerialValue(
            value: SerialValue&
        ): _ManualTextValue ?! SerializationError {
            return when value {
                .Text(text) -> .(text)
                else -> .UnexpectedType
            }
        }
    }

    pack _ImplSerializableFixture {
        fin value: String
    }

    derive Serializable(
        ignoreUnknownFields: true,
        encodeDefaults: false
    ) for _ImplSerializableFixture

    pack _DefaultSerializableFixture {
        fin value: String
    }

    derive Serializable for _DefaultSerializableFixture

    pack _DirectFieldDecoratorFixture {
        fin name: String = ""
        fin password: String = ""
    }

    derive SerialName(value: "display_name") for _DirectFieldDecoratorFixture::name

    pack _GroupedDecoratorFixture {
        fin name: String = ""
    }

    derive (SerialName, SerialRequired) for _GroupedDecoratorFixture::name

    pack _GroupedTargetFixture {
        fin name: String = ""
        fin password: String = ""
    }

    derive SerialIgnore for (_GroupedTargetFixture::name, _GroupedTargetFixture::password)

    pack _CrossProductDecoratorFixture {
        fin name: String = ""
        fin password: String = ""
    }

    derive (SerialName, SerialRequired) for (
        _CrossProductDecoratorFixture::name
        _CrossProductDecoratorFixture::password
    )

    pack WildcardDecoratorFixture {
        fin name: String = ""
        fin password: String = ""
    }

    derive SerialIgnore for WildcardDecoratorFixture::*

    pack _GroupedWildcardDecoratorFixture {
        fin name: String = ""
        fin password: String = ""
    }

    derive (SerialName, SerialRequired) for _GroupedWildcardDecoratorFixture::*
}

test "serializer decorator is visible at compile time" {
    inline assert reflect<SerializerMetadataFixture>.hasAnnot<Serializable> panic
        "@Serializable must be visible through hasAnnot"
}

test "serializer decorator exposes named options" {
    inline assert reflect<SerializerMetadataFixture>.annotMeta<Serializable>.ignoreUnknownFields panic
        "ignoreUnknownFields must retain its annotation value"
    inline assert !reflect<SerializerMetadataFixture>.annotMeta<Serializable>.encodeDefaults panic
        "encodeDefaults must retain its annotation value"
}

test "serial ignore is visible on fields" {
    inline assert reflect<SerializerMetadataFixture::secret>.hasAnnot<SerialIgnore> panic
        "@SerialIgnore must target field metadata"
}

test "serial name exposes its immutable value" {
    inline fin name = reflect<SerializerMetadataFixture::displayName>.annotMeta<SerialName>.value
    inline assert name == "display_name" panic "@SerialName must preserve its value"
}

test "azon-only decorator is independent" {
    inline assert reflect<_AzonMetadataFixture>.hasAnnot<AzonSerializable> panic
        "AZON-only metadata must be present"
    inline assert !reflect<_AzonMetadataFixture>.hasAnnot<Serializable> panic
        "AZON-only metadata must not imply the value-tree decorator"
}

test "manual Serializer impl converts a typed value" {
    fin serializer = _ManualTextSerializer()
    fin value = serializer.toSerialValue(_ManualTextValue("Azora")) catch SerialValue.Null
    fin encoded = encodeSerialValue(value, serializerOptions()) catch "error"
    assert encoded == "\"Azora\"" panic "Serializer.toSerialValue must use the implementation body"
}

test "manual Serializer impl reconstructs a typed value" {
    fin serializer = _ManualTextSerializer()
    fin serial: SerialValue = .Text("Azora")
    fin value = serializer.fromSerialValue(serial) catch _ManualTextValue("fallback")
    assert value.value == "Azora" { "Serializer.fromSerialValue must reconstruct the value" }
}

test "manual Serializer impl reports unexpected value types" {
    fin serializer = _ManualTextSerializer()
    fin value = serializer.fromSerialValue(SerialValue.Bool(true)) catch _ManualTextValue("failed")
    assert value.value == "failed" panic "the serializer must fail for an incompatible SerialValue"
}

test "manual Serializer impl round trips through AZON" {
    fin serializer = _ManualTextSerializer()
    let options = serializerOptions()
    fin tree = serializer.toSerialValue(_ManualTextValue("round-trip")) catch SerialValue.Null
    fin text = encodeSerialValue(tree, options) catch "error"
    fin decodedTree = decodeSerialValue(text, options) catch SerialValue.Null
    fin decoded = serializer.fromSerialValue(decodedTree) catch _ManualTextValue("failed")
    assert decoded.value == "round-trip" panic "custom serializers must compose with wire formats"
}

test "impl Serializable accepts configured decorator metadata" {
    inline assert reflect<_ImplSerializableFixture>.hasAnnot<Serializable> panic
        "empty decorator implementation bodies must be visible through hasAnnot"
    inline assert reflect<_ImplSerializableFixture>.annotMeta<Serializable>.ignoreUnknownFields panic
        "configured decorator implementations must expose named metadata"
    inline assert !reflect<_ImplSerializableFixture>.annotMeta<Serializable>.encodeDefaults panic
        "configured decorator implementations must override defaults"
}

test "impl Serializable still uses omitted metadata defaults" {
    inline assert reflect<_DefaultSerializableFixture>.hasAnnot<Serializable> panic
        "unconfigured decorator implementations must remain valid"
    inline assert !reflect<_DefaultSerializableFixture>.annotMeta<Serializable>.ignoreUnknownFields panic
        "omitted ignoreUnknownFields must use its default"
    inline assert reflect<_DefaultSerializableFixture>.annotMeta<Serializable>.encodeDefaults panic
        "omitted encodeDefaults must use its default"
}

test "decorator impl targets one pack field" {
    inline assert reflect<_DirectFieldDecoratorFixture::name>.hasAnnot<SerialName> panic
        "field implementation must apply SerialName to the selected field"
    inline fin name = reflect<_DirectFieldDecoratorFixture::name>.annotMeta<SerialName>.value
    inline assert name == "display_name" panic "field implementation must preserve configured metadata"
    inline assert !reflect<_DirectFieldDecoratorFixture::password>.hasAnnot<SerialName> panic
        "field implementation must not affect sibling fields"
}

test "decorator impl accepts a decorator list" {
    inline assert reflect<_GroupedDecoratorFixture::name>.hasAnnot<SerialName> panic
        "decorator lists must apply every listed decorator"
    inline assert reflect<_GroupedDecoratorFixture::name>.hasAnnot<SerialRequired> panic
        "decorator lists must preserve all marker contracts"
}

test "decorator impl accepts a field target list" {
    inline assert reflect<_GroupedTargetFixture::name>.hasAnnot<SerialIgnore> panic
        "target lists must decorate their first field"
    inline assert reflect<_GroupedTargetFixture::password>.hasAnnot<SerialIgnore> panic
        "target lists must decorate every selected field"
}

test "decorator and target lists form a cross product" {
    inline assert reflect<_CrossProductDecoratorFixture::name>.hasAnnot<SerialName> &&
        reflect<_CrossProductDecoratorFixture::name>.hasAnnot<SerialRequired> &&
        reflect<_CrossProductDecoratorFixture::password>.hasAnnot<SerialName> &&
        reflect<_CrossProductDecoratorFixture::password>.hasAnnot<SerialRequired> panic
        "each listed decorator must apply to each listed field"
}

test "field wildcard applies a decorator to every pack field" {
    inline assert reflect<WildcardDecoratorFixture::name>.hasAnnot<SerialIgnore> &&
        reflect<WildcardDecoratorFixture::password>.hasAnnot<SerialIgnore> panic
        "Pack::* must select every declared pack field"
}

test "field wildcard accepts a decorator list" {
    inline assert reflect<_GroupedWildcardDecoratorFixture::name>.hasAnnot<SerialName> &&
        reflect<_GroupedWildcardDecoratorFixture::name>.hasAnnot<SerialRequired> &&
        reflect<_GroupedWildcardDecoratorFixture::password>.hasAnnot<SerialName> &&
        reflect<_GroupedWildcardDecoratorFixture::password>.hasAnnot<SerialRequired> panic
        "decorator lists must apply to every field selected by Pack::*"
}

test "serial text extraction validates the slot type" {
    fin text = serialAsText(SerialValue.Text("Azora")) catch "failed"
    fin fallback = serialAsText(SerialValue.Bool(true)) catch "wrong-type"
    assert text == "Azora" panic "serialAsText must return text payloads"
    assert fallback == "wrong-type" panic "serialAsText must reject non-text values"
}

test "serial bool extraction validates the slot type" {
    fin boolean = serialAsBool(SerialValue.Bool(true)) catch false
    fin fallback = serialAsBool(SerialValue.Text("true")) catch false
    assert boolean panic "serialAsBool must return Boolean payloads"
    assert !fallback panic "serialAsBool must reject non-Boolean values"
}

test "serial char extraction requires exactly one character" {
    fin character = serialAsChar(SerialValue.Text("A")) catch '?'
    fin fallback = serialAsChar(SerialValue.Text("AB")) catch '?'
    assert character == 'A' panic "serialAsChar must return one character"
    assert fallback == '?' panic "serialAsChar must reject wider strings"
}

test "serial long extraction accepts signed integers" {
    fin positive = serialAsLong(SerialValue.Number("42")) catch -1
    fin negative = serialAsLong(SerialValue.Number("-17")) catch 0
    assert positive == 42 panic "serialAsLong must parse positive integers"
    assert negative == -17 panic "serialAsLong must parse negative integers"
}

test "serial long extraction rejects real syntax" {
    fin fraction = serialAsLong(SerialValue.Number("1.5")) catch -1
    fin exponent = serialAsLong(SerialValue.Number("1e2")) catch -2
    assert fraction == -1 panic "integral decoding must reject fractions"
    assert exponent == -2 panic "integral decoding must reject exponents"
}

test "serial long extraction rejects overflow" {
    fin overflow = serialAsLong(SerialValue.Number("9223372036854775808")) catch -1
    assert overflow == -1 panic "integral decoding must reject values above Long"
}

test "serial long extraction accepts the minimum value" {
    fin minimum = serialAsLong(SerialValue.Number("-9223372036854775808")) catch 0
    assert minimum == 0 - 9223372036854775807 - 1 panic "serialAsLong must preserve the full signed Long range"
}

test "serial integer extraction rejects narrowing overflow" {
    fin valid = serialAsInt(SerialValue.Number("2147483647")) catch -1
    fin overflow = serialAsInt(SerialValue.Number("2147483648")) catch -2
    assert valid == 2147483647 panic "serialAsInt must accept Int.maxValue"
    assert overflow == -2 panic "serialAsInt must reject values above Int"
}

test "serial real extraction accepts fractions" {
    fin value = serialAsReal(SerialValue.Number("12.5")) catch -1.0
    assert value == 12.5 panic "serialAsReal must parse fractional numbers"
}

test "serial real extraction accepts exponents" {
    fin positive = serialAsReal(SerialValue.Number("1.25e2")) catch -1.0
    fin negative = serialAsReal(SerialValue.Number("2.5e-1")) catch -1.0
    assert positive == 125.0 panic "serialAsReal must apply positive exponents"
    assert negative == 0.25 panic "serialAsReal must apply negative exponents"
}

test "serial number accepts zero" {
    assert isValidSerialNumber("0") panic "zero is a valid serialized number"
}

test "serial number accepts negative integer" {
    assert isValidSerialNumber("-42") panic "negative integers are valid"
}

test "serial number accepts fraction" {
    assert isValidSerialNumber("12.375") panic "fractions are valid"
}

test "serial number accepts exponent" {
    assert isValidSerialNumber("-1.25e+10") panic "exponents are valid"
}

test "serial number rejects empty input" {
    assert !isValidSerialNumber("") panic "an empty number token is invalid"
}

test "serial number rejects leading zero" {
    assert !isValidSerialNumber("01") panic "leading zeroes are invalid"
}

test "serial number rejects trailing decimal point" {
    assert !isValidSerialNumber("1.") panic "a fraction needs digits"
}

test "serial number rejects incomplete exponent" {
    assert !isValidSerialNumber("1e+") panic "an exponent needs digits"
}

test "serial number preserves exact source text" {
    let options = serializerOptions()
    fin number = serialNumber("9007199254740993123456789") catch SerialValue.Null
    fin encoded = encodeSerialValue(number, options) catch "error"
    assert encoded == "9007199254740993123456789" panic "large integers must not lose precision"
}

test "invalid number nodes cannot be encoded" {
    let options = serializerOptions()
    fin encoded = encodeSerialValue(
        SerialValue.Number("01"),
        options
    ) catch "invalid"
    assert encoded == "invalid" panic "invalid number text must fail encoding"
}

test "azon encodes scalar values" {
    let options = serializerOptions()
    fin nullText = encodeSerialValue(.Null, options) catch "error"
    fin trueText = encodeSerialValue(.Bool(true), options) catch "error"
    fin stringText = encodeSerialValue(.Text("Azora"), options) catch "error"
    assert nullText == "null" panic "null encoding changed"
    assert trueText == "true" panic "boolean encoding changed"
    assert stringText == "\"Azora\"" panic "text encoding changed"
}

test "azon round trips arrays" {
    let options = serializerOptions()
    fin value = decodeSerialValue("[1,true,null,\"x\"]", options) catch SerialValue.Null
    fin encoded = encodeSerialValue(value, options) catch "error"
    assert encoded == "[1,true,null,\"x\"]" panic "AZON arrays must round trip canonically"
}

test "azon round trips ordered objects" {
    let options = serializerOptions()
    fin value = decodeSerialValue("{\"id\":7,\"name\":\"Ada\"}", options) catch SerialValue.Null
    fin encoded = encodeSerialValue(value, options) catch "error"
    assert encoded == "{\"id\":7,\"name\":\"Ada\"}" panic "AZON object order must be deterministic"
}

test "decoder ignores insignificant whitespace" {
    let options = serializerOptions()
    fin value = decodeSerialValue(" { \"a\" : [ 1, 2 ] } ", options) catch SerialValue.Null
    fin encoded = encodeSerialValue(value, options) catch "error"
    assert encoded == "{\"a\":[1,2]}" panic "whitespace must not alter the value tree"
}

test "azon escapes control characters" {
    let options = serializerOptions()
    fin encoded = encodeSerialValue(SerialValue.Text("a\nb\tc"), options) catch "error"
    assert encoded == "\"a\\nb\\tc\"" panic "control characters must be escaped"
}

test "decoder resolves unicode escapes" {
    let options = serializerOptions()
    fin value = decodeSerialValue("\"\\u0041\"", options) catch SerialValue.Null
    fin encoded = encodeSerialValue(value, options) catch "error"
    assert encoded == "\"A\"" panic "unicode escapes must decode to their character"
}

test "decoder rejects invalid escapes" {
    let options = serializerOptions()
    fin value = decodeSerialValue("\"\\x\"", options) catch SerialValue.Text("failed")
    fin encoded = encodeSerialValue(value, options) catch "error"
    assert encoded == "\"failed\"" panic "invalid escapes must fail decoding"
}

test "decoder rejects trailing content" {
    let options = serializerOptions()
    fin value = decodeSerialValue("true false", options) catch SerialValue.Text("failed")
    fin encoded = encodeSerialValue(value, options) catch "error"
    assert encoded == "\"failed\"" panic "trailing content must be rejected"
}

test "decoder rejects duplicate object fields by default" {
    let options = serializerOptions()
    fin value = decodeSerialValue("{\"a\":1,\"a\":2}", options) catch SerialValue.Text("failed")
    fin encoded = encodeSerialValue(value, options) catch "error"
    assert encoded == "\"failed\"" panic "duplicate fields must be rejected by default"
}

test "decoder can retain duplicate object fields explicitly" {
    var options = serializerOptions()
    options.allowDuplicateFields = true
    fin value = decodeSerialValue("{\"a\":1,\"a\":2}", options) catch SerialValue.Null
    fin encoded = encodeSerialValue(value, options) catch "error"
    assert encoded == "{\"a\":1,\"a\":2}" panic "explicit duplicate handling must preserve order"
}

test "azon rejects equals separators" {
    let options = serializerOptions()
    fin value = decodeSerialValue("{\"a\"=1}", options) catch SerialValue.Text("failed")
    fin encoded = encodeSerialValue(value, options) catch "error"
    assert encoded == "\"failed\"" panic "AZON must require colon separators"
}

test "decoder enforces input length" {
    var options = serializerOptions()
    options.maxInputLength = 4
    fin value = decodeSerialValue("false", options) catch SerialValue.Text("failed")
    fin encoded = encodeSerialValue(value, options) catch "error"
    assert encoded == "\"failed\"" panic "maxInputLength must be enforced before parsing"
}

test "decoder enforces nesting depth" {
    var options = serializerOptions()
    options.maxDepth = 0
    fin value = decodeSerialValue("[[]]", options) catch SerialValue.Text("failed")
    fin encoded = encodeSerialValue(value, options) catch "error"
    assert encoded == "\"failed\"" panic "maxDepth must reject deeply nested input"
}

test "encoder omits null object fields when configured" {
    var options = serializerOptions()
    options.encodeNulls = false
    fin value = decodeSerialValue("{\"a\":null,\"b\":1}", serializerOptions()) catch SerialValue.Null
    fin encoded = encodeSerialValue(value, options) catch "error"
    assert encoded == "{\"b\":1}" panic "encodeNulls=false must omit null object fields"
}

test "pretty encoder uses configured indentation" {
    var options = serializerOptions()
    options.pretty = true
    options.indent = "    "
    fin value = decodeSerialValue("[1,2]", serializerOptions()) catch SerialValue.Null
    fin encoded = encodeSerialValue(value, options) catch "error"
    assert encoded == "[\n    1,\n    2\n]" panic "pretty output must use the configured indent"
}

test "serial field returns an existing object member" {
    fin options = serializerOptions()
    fin object = decodeSerialValue("{\"id\":17}", options) catch SerialValue.Null
    fin value = serialField(object, "id") catch SerialValue.Null
    fin encoded = encodeSerialValue(value, options) catch "error"
    assert encoded == "17" panic "serialField must return the requested value"
}

test "serial field fails for a missing member" {
    fin options = serializerOptions()
    fin object = decodeSerialValue("{\"id\":17}", options) catch SerialValue.Null
    fin value = serialField(object, "name") catch SerialValue.Text("missing")
    fin encoded = encodeSerialValue(value, options) catch "error"
    assert encoded == "\"missing\"" panic "serialField must fail for absent names"
}

test "serial field rejects non-object values" {
    fin options = serializerOptions()
    fin value = serialField(SerialValue.Bool(true), "name") catch SerialValue.Text("wrong-type")
    fin encoded = encodeSerialValue(value, options) catch "error"
    assert encoded == "\"wrong-type\"" panic "serialField must reject non-object values"
}

test .All "serializer"
